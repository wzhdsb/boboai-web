---
import Layout from "../layouts/Layout.astro";

const DL = "https://github.com/wzhdsb/mobile-ai-assistant-releases/releases/latest";
const MIRROR = "https://ghfast.top/";

const features = [
  {
    title: "AI 对话",
    desc: "GLM 大模型直连：语音输入、拍照识图、多会话管理。快速应答模式约三倍提速，深度思考进度实时可见。",
    icon: "chat",
  },
  {
    title: "实时行情",
    desc: "A股 + 美股：指数分时、个股 K 线、筹码峰，盘中秒级刷新；自选与持仓一处管理。",
    icon: "chart",
  },
  {
    title: "AI 个股分析",
    desc: "深度研究模式：多轮推演、消息面联动、结论前置的个股体检报告，思考与开销全程透明。",
    icon: "brain",
  },
  {
    title: "盘中提醒",
    desc: "买卖点条件触发，高优通知横幅 + 响铃，后台保活不漏单；预判贴合自动回验，越用越准。",
    icon: "bell",
  },
  {
    title: "消息面日报",
    desc: "每日三档（盘前 / 午间 / 盘后）AI 日报：快讯映射板块、传闻雷达、明日看点，积攒你的盘感。",
    icon: "news",
  },
  {
    title: "博主情报",
    desc: "微博 / B站 / 小红书 / 抖音博主动态定时抓取，AI 总结历史脉络，沉淀为可检索的专属知识库。",
    icon: "users",
  },
];

const tiers = [
  {
    name: "基础版",
    tag: "V0",
    highlight: false,
    items: ["AI 对话 · 识图 · 语音", "实时行情与自选持仓", "盘中买卖点提醒", "本地备份与恢复"],
  },
  {
    name: "情报版",
    tag: "V1",
    highlight: false,
    items: ["基础版全部功能", "多平台博主情报", "定时轮询与提醒", "专属知识库"],
  },
  {
    name: "旗舰版",
    tag: "V2",
    highlight: true,
    items: ["情报版全部功能", "每日三档消息面日报", "AI 深度个股分析", "预判回验与错案反哺"],
  },
];

const faqs = [
  {
    q: "需要什么配置的手机？",
    a: "Android 11（API 30）及以上，无需 root。安装包约 17MB，建议 6GB 以上内存的机型以获得流畅的后台体验。",
  },
  {
    q: "免费试用怎么算？",
    a: "首次启动起 7 天全功能试用，无需注册账号。到期后输入激活码解锁，换机可自助换绑设备。",
  },
  {
    q: "我的数据存在哪里？",
    a: "聊天、自选、持仓、知识库全部本地存储，支持口令加密的一键备份导出；不经任何第三方服务器。",
  },
  {
    q: "AI 能力需要自己提供 Key 吗？",
    a: "是。对话与分析使用你自己的智谱 API Key，额度与花销自己掌控，App 内透明记账，不经过中间商。",
  },
  {
    q: "激活后能离线用吗？",
    a: "能。激活票据本地 Ed25519 验签，离线可用；联网时每 24 小时自动静默续签，无需反复输码。",
  },
];
---

<Layout title="BOBO AI 助理 — 住进手机里的 AI 助理">
  <header>
    <div class="container nav">
      <a class="brand" href="#top">
        <svg viewBox="0 0 64 64" width="26" height="26" aria-hidden="true">
          <rect x="4" y="4" width="56" height="56" rx="14" fill="#10141d" stroke="#2a3245" stroke-width="2"/>
          <path d="M22 18h12a8 8 0 0 1 0 16H22zm0 16h14a8 8 0 0 1 0 16H22z"
                fill="none" stroke="#5b9dff" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>BOBO</span>
      </a>
      <nav>
        <a href="#features">功能</a>
        <a href="#tiers">版本</a>
        <a href="#download">下载</a>
        <a href="#faq">FAQ</a>
      </nav>
    </div>
  </header>

  <main id="top">
    <!-- Hero -->
    <section class="hero">
      <div class="container">
        <p class="kicker">BOBO · ANDROID · v1.7</p>
        <h1>住进手机里的<br /><span class="grad">AI 助理</span></h1>
        <p class="sub">
          看得懂屏幕，读得懂行情，追得上博主。<br class="mobile-br" />
          GLM 大模型 × 无障碍 × 数据全本地。
        </p>
        <div class="cta">
          <a class="btn primary" href={DL} target="_blank" rel="noopener">立即下载</a>
          <a class="btn ghost" href="#features">了解功能</a>
        </div>
        <p class="meta">Android 11+ · 约 17MB · 新用户 7 天全功能试用</p>
      </div>
    </section>

    <!-- Features -->
    <section id="features" class="alt">
      <div class="container">
        <p class="kicker">Features</p>
        <h2>一个 App，三副面孔</h2>
        <p class="lead">日常是贴心助理，盘中是行情哨兵，盘后是情报主编。</p>
        <div class="grid c3" style="margin-top:36px">
          {features.map((f) => (
            <div class="card">
              <div class="icon" aria-hidden="true">
                {f.icon === "chat" && <svg viewBox="0 0 24 24"><path d="M4 6a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v7a3 3 0 0 1-3 3H9l-4 4v-4H7a3 3 0 0 1-3-3z"/></svg>}
                {f.icon === "chart" && <svg viewBox="0 0 24 24"><path d="M4 19V5m0 14h16M8 15l3-5 3 3 4-6"/></svg>}
                {f.icon === "brain" && <svg viewBox="0 0 24 24"><path d="M12 4a4 4 0 0 0-4 4 3.5 3.5 0 0 0-1 6.8A3 3 0 0 0 10 20h2zM12 4a4 4 0 0 1 4 4 3.5 3.5 0 0 1 1 6.8A3 3 0 0 1 14 20h-2m0-16v16"/></svg>}
                {f.icon === "bell" && <svg viewBox="0 0 24 24"><path d="M6 9a6 6 0 1 1 12 0c0 5 2 6 2 6H4s2-1 2-6M10 20a2 2 0 0 0 4 0"/></svg>}
                {f.icon === "news" && <svg viewBox="0 0 24 24"><path d="M5 4h12v16H6a2 2 0 0 1-2-2V6a2 2 0 0 1 1-2zm12 4h3a1 1 0 0 1 1 1v9a2 2 0 0 1-2 2h-2M8 8h6M8 12h6M8 16h4"/></svg>}
                {f.icon === "users" && <svg viewBox="0 0 24 24"><path d="M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm-7 8a7 7 0 0 1 14 0M16 11a3 3 0 1 0 0-6m1 14a7 7 0 0 0-2-4.9 7 7 0 0 1 7 4.9"/></svg>}
              </div>
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Tiers -->
    <section id="tiers">
      <div class="container">
        <p class="kicker">Editions</p>
        <h2>三档等级，按需解锁</h2>
        <p class="lead">新用户 7 天全功能试用；激活码分 V0 / V1 / V2 三档，订阅周期含 1 月、3 月、1 年与终身。</p>
        <div class="grid c3" style="margin-top:36px">
          {tiers.map((t) => (
            <div class={`card tier ${t.highlight ? "hot" : ""}`}>
              {t.highlight && <span class="badge">推荐</span>}
              <div class="tier-head">
                <span class="tier-tag">{t.tag}</span>
                <h3>{t.name}</h3>
              </div>
              <ul>
                {t.items.map((i) => <li>{i}</li>)}
              </ul>
            </div>
          ))}
        </div>
        <p class="note">定价与购买渠道以发布页公告为准；已激活设备可自助换绑。</p>
      </div>
    </section>

    <!-- Download -->
    <section id="download" class="alt">
      <div class="container">
        <p class="kicker">Download</p>
        <h2>拿到它</h2>
        <div class="dl-row">
          <div class="card dl">
            <h3>GitHub Releases</h3>
            <p>主渠道，最新版 v1.7.0（versionCode 18）。App 内置应用内更新，之后不必再手动下载。</p>
            <a class="btn primary" href={DL} target="_blank" rel="noopener">前往下载</a>
          </div>
          <div class="card dl">
            <h3>下载慢？</h3>
            <p>
              国内网络可在 App 的「检查更新 → ⚙ 配置」里填镜像前缀加速：<code>{MIRROR}</code>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq">
      <div class="container">
        <p class="kicker">FAQ</p>
        <h2>常见问题</h2>
        <div class="faq-list">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      <p>BOBO AI 助理 · <a href="https://boboai.tech">boboai.tech</a></p>
      <p class="fine">本站由 Cloudflare 全球边缘网络加速 · © 2026 · Android 是 Google LLC 的商标</p>
    </div>
  </footer>
</Layout>

<style>
  /* nav */
  header {
    position: sticky; top: 0; z-index: 10;
    background: rgba(11, 14, 20, 0.82);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .nav { display: flex; align-items: center; justify-content: space-between; height: 60px; }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 17px; letter-spacing: 0.04em; }
  nav { display: flex; gap: 26px; }
  nav a { color: var(--text-dim); font-size: 14.5px; transition: color 0.15s; }
  nav a:hover { color: var(--text); }

  /* hero */
  .hero { padding: 110px 0 96px; text-align: center; position: relative; overflow: hidden; }
  .hero::before {
    content: ""; position: absolute; inset: -40% -20% auto;
    height: 130%;
    background:
      radial-gradient(600px 300px at 30% 30%, rgba(91, 157, 255, 0.14), transparent 70%),
      radial-gradient(500px 260px at 70% 40%, rgba(230, 180, 80, 0.08), transparent 70%);
    pointer-events: none;
  }
  .hero .container { position: relative; }
  h1 {
    font-size: clamp(38px, 7vw, 64px);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: 0.01em;
    margin: 18px 0 20px;
  }
  .grad {
    background: linear-gradient(92deg, var(--accent) 10%, #9db8ff 45%, var(--gold) 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .sub { color: var(--text-dim); font-size: clamp(16px, 2.2vw, 19px); }
  .cta { display: flex; gap: 14px; justify-content: center; margin: 34px 0 18px; flex-wrap: wrap; }
  .btn {
    display: inline-block; padding: 12px 30px; border-radius: 10px;
    font-size: 15.5px; font-weight: 600; line-height: 1.4;
    border: 1px solid transparent; transition: transform 0.15s, box-shadow 0.15s;
  }
  .btn:hover { transform: translateY(-1px); }
  .btn.primary {
    background: linear-gradient(135deg, #3d7bf0, #5b9dff);
    color: #fff;
    box-shadow: 0 6px 22px rgba(61, 123, 240, 0.32);
  }
  .btn.ghost { border-color: var(--border); color: var(--text-dim); }
  .btn.ghost:hover { color: var(--text); border-color: rgba(148, 163, 197, 0.3); }
  .meta { color: var(--text-faint); font-size: 13.5px; letter-spacing: 0.02em; }

  /* sections */
  .alt { background: var(--bg-soft); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }

  /* cards */
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 26px 24px;
  }
  .card h3 { font-size: 17px; font-weight: 650; margin-bottom: 8px; }
  .card p { color: var(--text-dim); font-size: 14.5px; }
  .icon {
    width: 42px; height: 42px; border-radius: 11px;
    background: var(--accent-soft);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 16px;
  }
  .icon svg { width: 22px; height: 22px; fill: none; stroke: var(--accent); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }

  /* tiers */
  .tier { position: relative; }
  .tier ul { list-style: none; margin-top: 14px; }
  .tier li { padding: 7px 0 7px 24px; position: relative; color: var(--text-dim); font-size: 14.5px; }
  .tier li::before {
    content: ""; position: absolute; left: 2px; top: 14px;
    width: 13px; height: 7px;
    border-left: 2px solid var(--green); border-bottom: 2px solid var(--green);
    transform: rotate(-45deg);
  }
  .tier.hot { border-color: rgba(91, 157, 255, 0.45); box-shadow: 0 0 0 1px rgba(91, 157, 255, 0.22), 0 14px 40px rgba(6, 12, 26, 0.5); }
  .badge {
    position: absolute; top: -12px; right: 18px;
    background: linear-gradient(135deg, #3d7bf0, #5b9dff);
    color: #fff; font-size: 12px; font-weight: 600;
    padding: 3px 12px; border-radius: 999px;
  }
  .tier-head { display: flex; align-items: center; gap: 12px; }
  .tier-tag {
    font-family: var(--mono); font-size: 12.5px; font-weight: 700;
    color: var(--gold); background: var(--gold-soft);
    padding: 2px 9px; border-radius: 7px;
  }
  .note { color: var(--text-faint); font-size: 13.5px; margin-top: 22px; }

  /* download */
  .dl-row { display: grid; gap: 16px; margin-top: 32px; }
  @media (min-width: 720px) { .dl-row { grid-template-columns: 1.4fr 1fr; } }
  .dl .btn { margin-top: 18px; }
  .dl code {
    font-family: var(--mono); font-size: 13px;
    background: var(--bg); border: 1px solid var(--border);
    padding: 2px 8px; border-radius: 6px; color: var(--gold);
  }

  /* faq */
  .faq-list { margin-top: 28px; display: grid; gap: 10px; }
  details {
    background: var(--card); border: 1px solid var(--border);
    border-radius: 12px; padding: 16px 22px;
  }
  summary { cursor: pointer; font-weight: 600; font-size: 15.5px; list-style: none; position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: "+"; position: absolute; right: 4px; top: 50%;
    transform: translateY(-50%); color: var(--text-faint); font-size: 18px;
  }
  details[open] summary::after { content: "–"; }
  details p { color: var(--text-dim); font-size: 14.5px; margin-top: 10px; max-width: 720px; }

  /* footer */
  footer { border-top: 1px solid var(--border); padding: 34px 0 44px; color: var(--text-faint); font-size: 14px; }
  footer .fine { font-size: 12.5px; margin-top: 6px; }
  footer a { color: var(--text-dim); }
</style>
