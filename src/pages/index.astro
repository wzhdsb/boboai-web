---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Aurora from "../components/Aurora.astro";
import QRCode from "qrcode";
import { VERSION, VCODE, APK, GITHUB, MIRROR, SITE } from "../config";

// 扫码下载真码：构建期生成 SVG（零 JS 约定不破），指向与主按钮相同的 APK 直链
const qrSvg = await QRCode.toString(`${SITE}${APK}`, {
  type: "svg",
  margin: 1, // 静区主要靠 qr-box 的白底留白，这里再补 1 模块
  color: { dark: "#1a1a19", light: "#00000000" }, // dark = --ink-1，底透明交给白盒子
});

// ===== 内容数组：改文案只改这里 =====
const features = [
  {
    cls: "cell--blue c-chat",
    icon: "chat",
    title: "AI 对话",
    tag: "GLM 大模型直连",
    body: "语音输入、拍照识图、多会话管理。快速应答模式约三倍提速，深度思考进度实时可见。",
    mock: "chat",
  },
  {
    cls: "cell--red c-quote",
    icon: "candle",
    title: "实时行情",
    tag: "A股 + 美股",
    body: "指数分时、个股 K 线、筹码峰，盘中秒级刷新；自选与持仓一处管理。",
    mock: "quote",
  },
  {
    cls: "cell--violet c-stock",
    icon: "doc",
    title: "AI 个股分析",
    tag: "深度研究模式",
    body: "多轮推演、消息面联动、结论前置的个股体检报告，思考与开销全程透明。",
    mock: "report",
  },
  {
    cls: "cell--orange c-alert",
    icon: "bell",
    title: "盘中提醒",
    body: "买卖点条件触发，高优通知横幅 + 响铃，后台保活不漏单；预判贴合自动回验，越用越准。",
    mock: "notif",
  },
  {
    cls: "cell--gold c-news",
    icon: "news",
    title: "消息面日报",
    tag: "每日三档（盘前 / 午间 / 盘后）",
    body: "AI 日报：快讯映射板块、传闻雷达、明日看点，积攒你的盘感。",
    mock: "timeline",
  },
  {
    cls: "cell--magenta c-blogger",
    icon: "at",
    title: "博主情报",
    body: "博主动态定时抓取，AI 总结历史脉络，沉淀为可检索的专属知识库。",
    mock: "kb",
  },
];

// 行尾数据小格
const stats = [
  { icon: "android", value: "Android 11+", cap: "无需 root · API 30" },
  { icon: "box", pre: "约 ", value: "17MB", cap: "安装包体积" },
  { icon: "clock", value: "7 天", unit: "试用", cap: "新用户全功能", tint: "tint-blue" },
  { icon: "layers", value: VERSION, cap: `versionCode ${VCODE}`, tint: "tint-violet" },
  { icon: "at", value: "4 平台", unit: "博主", cap: "微博 / B站 / 小红书 / 抖音" },
  { icon: "news", value: "三档", unit: "日报", cap: "盘前 / 午间 / 盘后" },
];

const tiers = [
  {
    name: "基础版",
    tag: "V0",
    hot: false,
    desc: "开箱即用的日常主力",
    items: ["AI 对话·识图·语音", "实时行情与自选持仓", "盘中买卖点提醒", "本地备份与恢复"],
    cta: "订阅基础版",
  },
  {
    name: "情报版",
    tag: "V1",
    hot: false,
    desc: "把博主情报装进口袋",
    items: ["基础版全部功能", "多平台博主情报", "定时轮询与提醒", "专属知识库"],
    cta: "订阅情报版",
  },
  {
    name: "旗舰版",
    tag: "V2",
    hot: true,
    desc: "全能力 · 越用越懂你",
    items: ["情报版全部功能", "每日三档消息面日报", "AI 深度个股分析", "预判回验与错案反哺"],
    cta: "订阅旗舰版",
  },
];

const faqs = [
  {
    q: "需要什么配置的手机？",
    a: "Android 11（API 30）及以上，无需 root。安装包约 17MB，建议 6GB 以上内存的机型以获得流畅的后台体验。",
  },
  {
    q: "免费试用怎么算？",
    a: "首次启动起 7 天全功能试用，无需注册账号。到期后输入激活码解锁，换机可自助换绑设备。",
  },
  {
    q: "我的数据存在哪里？",
    a: "聊天、自选、持仓、知识库全部本地存储，支持口令加密的一键备份导出；不经任何第三方服务器。",
  },
  {
    q: "AI 能力需要自己提供 Key 吗？",
    a: "是。对话与分析使用你自己的智谱 API Key，额度与花销自己掌控，App 内透明记账，不经过中间商。",
  },
  {
    q: "激活后能离线用吗？",
    a: "能。激活票据本地 Ed25519 验签，离线可用；联网时每 24 小时自动静默续签，无需反复输码。",
  },
];
---

<Layout title="BOBO AI 助理 — 住进手机里的 AI 助理">
  <Aurora strength="full" />
  <Nav />

  <!-- ====== Hero ====== -->
  <header class="hero" id="top">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="pill"><span class="dot"></span>{VERSION} · 现已发布</span>
        <h1>住进手机里的<br /><span class="grad">AI 助理</span></h1>
        <p class="sub">看得懂屏幕，读得懂行情，追得上博主。<br /><b>GLM 大模型 × 无障碍 × 数据全本地。</b></p>
        <div class="cta-row">
          <a class="btn btn-primary" href={APK}>
            <svg class="ic" aria-hidden="true"><use href="#i-dl" /></svg>立即下载
          </a>
          <a class="btn btn-ghost" href="#features">了解功能</a>
        </div>
        <div class="meta-row">
          <span class="m"><svg class="ic" aria-hidden="true"><use href="#i-android" /></svg>Android 11+</span><span class="sep">·</span>
          <span class="m"><svg class="ic" aria-hidden="true"><use href="#i-box" /></svg>约 17MB</span><span class="sep">·</span>
          <span class="m"><svg class="ic" aria-hidden="true"><use href="#i-clock" /></svg>新用户 7 天全功能试用</span>
        </div>
      </div>

      <!-- Hero 右侧：迷你 Bento 拼贴 -->
      <div class="hero-bento" aria-hidden="true">
        <div class="hb hb-wide">
          <div class="hb-top" style="color:#d03b3b"><svg class="ic"><use href="#i-candle" /></svg>实时行情 · A股 + 美股</div>
          <svg class="spark" viewBox="0 0 200 56" role="img">
            <path class="area" d="M0 40 L16 34 L32 38 L48 28 L64 32 L80 22 L96 26 L112 18 L128 22 L144 12 L160 16 L176 9 L192 6 L200 5 L200 56 L0 56 Z"/>
            <path class="line" pathLength="1" d="M0 40 L16 34 L32 38 L48 28 L64 32 L80 22 L96 26 L112 18 L128 22 L144 12 L160 16 L176 9 L192 6 L200 5"/>
            <circle class="dotp" cx="192" cy="6" r="2.6"/>
            <g class="halo"><circle cx="192" cy="6" r="3.4"/></g>
          </svg>
          <div style="display:flex;gap:8px;flex-wrap:wrap">
            <span class="chip up">上证 +0.86% ▲</span>
            <span class="chip dn">纳指 −0.42% ▼</span>
          </div>
        </div>
        <div class="hb">
          <div class="hb-top" style="color:#1f66b8"><svg class="ic"><use href="#i-chat" /></svg>AI 对话</div>
          <span class="chip"><svg class="ic"><use href="#i-zap" /></svg>快速应答 · 约 3× 提速</span>
        </div>
        <div class="hb">
          <div class="hb-top" style="color:#c2551d"><svg class="ic"><use href="#i-bell" /></svg>盘中提醒</div>
          <span class="chip"><span style="width:6px;height:6px;border-radius:50%;background:#d95926;display:inline-block"></span>买卖点条件触发</span>
        </div>
        <div class="hb hb-slim">
          <span class="vtag">{VERSION} <small>· versionCode {VCODE}</small></span>
          <span class="chip" style="margin-top:0"><svg class="ic"><use href="#i-cloud" /></svg>应用内更新</span>
        </div>
      </div>
    </div>
  </header>

  <main>
    <!-- ====== 功能 Bento ====== -->
    <section id="features">
      <div class="wrap">
        <div class="sec-head">
          <span class="eyebrow">Features</span>
          <h2>六大核心能力</h2>
          <p class="sec-sub">AI 对话、实时行情、个股分析、盘中提醒、消息面日报、博主情报——装进同一个约 17MB 的 App，数据全部本地存储。</p>
        </div>

        <div class="bento">
          {features.map((f) => (
            <article class={`cell acc ${f.cls}`}>
              <div class="cell-head">
                <span class="ico"><svg class="ic" aria-hidden="true"><use href={`#i-${f.icon}`} /></svg></span>
                <div>
                  <h3>{f.title}</h3>
                  {f.tag && <span class="tag">{f.tag}</span>}
                </div>
              </div>

              {f.mock === "chat" && (
                <Fragment>
                  <p class="body">{f.body}</p>
                  <div class="mock" aria-hidden="true">
                    <div class="msg user">帮我看看今天的有色板块</div>
                    <div class="msg ai">正在深度思考<span class="typing"><i></i><i></i><i></i></span></div>
                    <div class="think"><span>深度思考</span><span class="bar"></span><span>62%</span></div>
                    <div class="msg ai">已切入快速应答模式，这轮解读约 2 秒出稿。</div>
                  </div>
                  <div class="cap-chips">
                    <span><svg class="ic" aria-hidden="true"><use href="#i-mic" /></svg>语音输入</span>
                    <span><svg class="ic" aria-hidden="true"><use href="#i-cam" /></svg>拍照识图</span>
                    <span><svg class="ic" aria-hidden="true"><use href="#i-layers" /></svg>多会话管理</span>
                  </div>
                </Fragment>
              )}

              {f.mock === "quote" && (
                <Fragment>
                  <span class="spark-cap">指数分时 · 示意</span>
                  <svg class="spark" viewBox="0 0 320 96" role="img" aria-label="指数分时走势示意图">
                    <line class="gline" x1="0" y1="24" x2="320" y2="24"/>
                    <line class="gline" x1="0" y1="48" x2="320" y2="48"/>
                    <line class="gline" x1="0" y1="72" x2="320" y2="72"/>
                    <path class="area" d="M0 62 L24 54 L48 58 L72 44 L96 50 L120 38 L144 42 L168 30 L192 34 L216 24 L240 28 L264 18 L288 22 L312 12 L320 10 L320 96 L0 96 Z"/>
                    <path class="line" pathLength="1" d="M0 62 L24 54 L48 58 L72 44 L96 50 L120 38 L144 42 L168 30 L192 34 L216 24 L240 28 L264 18 L288 22 L312 12 L320 10"/>
                    <circle class="dotp" cx="312" cy="12" r="3"/>
                    <g class="halo"><circle cx="312" cy="12" r="3.6"/></g>
                  </svg>
                  <div class="idx" aria-hidden="true">
                    <span>上证指数 <b>3,286.40</b> <em class="up">+0.86% ▲</em></span>
                    <span>深证成指 <b>10,514.27</b> <em class="up">+1.12% ▲</em></span>
                    <span>纳斯达克 <b>17,842.60</b> <em class="dn">−0.42% ▼</em></span>
                    <span>道琼斯 <b>41,238.15</b> <em class="up">+0.15% ▲</em></span>
                  </div>
                  <div class="peak" aria-hidden="true">
                    <div class="peak-lab"><span>筹码峰</span><span>盘中秒级刷新</span></div>
                    <div class="peak-bars">
                      <i style="height:22%"></i><i style="height:30%"></i><i style="height:42%"></i><i style="height:60%"></i>
                      <i class="warm" style="height:76%"></i><i class="warm" style="height:90%"></i><i class="hot" style="height:97%"></i>
                      <i class="warm" style="height:88%"></i><i style="height:72%"></i><i style="height:58%"></i>
                      <i style="height:44%"></i><i style="height:33%"></i><i style="height:25%"></i><i style="height:19%"></i>
                    </div>
                  </div>
                  <p class="body">{f.body}</p>
                </Fragment>
              )}

              {f.mock === "report" && (
                <Fragment>
                  <p class="body">{f.body}</p>
                  <div class="report" aria-hidden="true">
                    <div class="r-top"><span class="r-badge">结论前置</span>个股体检报告 · 示意</div>
                    <div class="sk v" style="width:82%"></div>
                    <div class="sk" style="width:58%"></div>
                    <div class="r-foot"><span>多轮推演 · 消息面联动</span><span>开销透明</span></div>
                  </div>
                </Fragment>
              )}

              {f.mock === "notif" && (
                <Fragment>
                  <div class="notif" aria-hidden="true">
                    <span class="nb"><svg class="ic"><use href="#i-bell" /></svg></span>
                    <div><div class="nt">高优通知横幅 + 响铃</div><div class="ns">买卖点条件触发 · 后台保活不漏单</div></div>
                    <span class="live"></span>
                  </div>
                  <p class="body">{f.body}</p>
                </Fragment>
              )}

              {f.mock === "timeline" && (
                <Fragment>
                  <div class="tl" aria-hidden="true">
                    <div class="node"><span class="nd"><svg class="ic"><use href="#i-sun" /></svg></span><span class="nl">盘前</span></div>
                    <div class="node mid"><span class="nd"><svg class="ic"><use href="#i-news" /></svg></span><span class="nl">午间</span></div>
                    <div class="node"><span class="nd"><svg class="ic"><use href="#i-clock" /></svg></span><span class="nl">盘后</span></div>
                  </div>
                  <p class="body">{f.body}</p>
                </Fragment>
              )}

              {f.mock === "kb" && (
                <Fragment>
                  <div class="pf" aria-hidden="true">
                    <span><i style="background:#d03b3b"></i>微博</span>
                    <span><i style="background:#1f66b8"></i>B站</span>
                    <span><i style="background:#b23a68"></i>小红书</span>
                    <span><i style="background:#199e70"></i>抖音</span>
                  </div>
                  <p class="body">{f.body}</p>
                  <div class="kb" aria-hidden="true">
                    <svg class="ic"><use href="#i-search" /></svg>
                    <div class="kbs"><div class="sk" style="width:74%"></div><div class="sk" style="width:46%"></div></div>
                  </div>
                </Fragment>
              )}
            </article>
          ))}

          {stats.map((s) => (
            <div class={`cell c-stat ${s.tint ?? ""}`}>
              <svg class="sico" aria-hidden="true"><use href={`#i-${s.icon}`} /></svg>
              <div>
                <div class="sval">{s.pre && <small>{s.pre}</small>}{s.value}{s.unit && <small>{s.unit}</small>}</div>
                <div class="scap">{s.cap}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ====== 三档等级 ====== -->
    <section id="plans">
      <div class="wrap">
        <div class="sec-head">
          <span class="eyebrow">Editions</span>
          <h2>三档等级</h2>
          <p class="sec-sub">旗舰版 V2 为推荐档：全能力开放，预判回验与错案反哺持续进化。已订阅低档？随时补差价升级。</p>
        </div>
        <div class="plans">
          {tiers.map((t) => (
            <article class={`plan ${t.hot ? "plan--hot" : ""}`}>
              {t.hot && <span class="badge">推荐</span>}
              <div class="tname">{t.name}<span class="tier">{t.tag}</span></div>
              <p class="tdesc">{t.desc}</p>
              <ul>
                {t.items.map((i) => (
                  <li><svg class="ic" aria-hidden="true"><use href="#i-check" /></svg>{i}</li>
                ))}
              </ul>
              <a class={`btn ${t.hot ? "btn-primary" : "btn-ghost"} btn-sm`} href="/pricing/">
                {t.hot && <svg class="ic" aria-hidden="true"><use href="#i-zap" /></svg>}{t.cta}
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ====== 下载 ====== -->
    <section id="download">
      <div class="wrap">
        <div class="sec-head">
          <span class="eyebrow">Download</span>
          <h2>下载安装</h2>
          <p class="sec-sub">下载即用，无需注册账号；装好这一次，往后的版本更新都在 App 内完成。</p>
        </div>
        <div class="dl-grid">
          <!-- 主下载格：官网直链（唯一强 CTA） -->
          <article class="cell acc cell--blue dl-main">
            <div class="cell-head">
              <span class="ico"><svg class="ic" aria-hidden="true"><use href="#i-dl" /></svg></span>
              <div><h3>官网直链下载</h3><span class="tag">推荐 · 无需跳转第三方</span></div>
            </div>
            <a class="dl-btn" href={APK} download>
              <svg class="ic" aria-hidden="true"><use href="#i-dl" /></svg>下载 APK · {VERSION}
            </a>
            <p class="dl-ver">版本 {VERSION}（versionCode {VCODE}）· 约 17MB · Android 11+</p>
          </article>

          <!-- 扫码格 -->
          <article class="cell dl-qr">
            <div class="qr-box">
              <!-- 构建期生成的真二维码（frontmatter qrSvg），指向与主按钮相同的 APK 直链 -->
              <div class="qr" set:html={qrSvg} role="img" aria-label={`扫码下载二维码，指向 ${SITE}${APK}`} />
            </div>
            <div class="qr-txt">
              <h3>手机扫码，直接下载</h3>
              <p>官网直链 · 无需跳转第三方</p>
            </div>
          </article>

          <!-- 安装指引折叠格（零 JS） -->
          <details class="cell dl-fold dl-help">
            <summary>下载后装不上？<span class="pm"></span></summary>
            <div class="fbody">
              <ol class="dl-steps">
                <li><span class="n">1</span><div>系统提示「未知来源 / 安装未知应用」时，按引导把权限授给浏览器或文件管理器（设置 → 应用 → 特殊应用权限）</div></li>
                <li><span class="n">2</span><div>在「下载」目录找到 bobo-{VERSION}.apk</div></li>
                <li><span class="n">3</span><div>点击安装，等待完成</div></li>
                <li><span class="n">4</span><div>首次启动，7 天全功能试用自动生效，无需注册账号</div></li>
              </ol>
            </div>
          </details>

          <!-- 其他下载方式折叠格（GitHub 降级为备用） -->
          <details class="cell dl-fold dl-more">
            <summary>其他下载方式<span class="pm"></span></summary>
            <div class="fbody dl-alt">
              <p><a class="dl-gh" href={GITHUB} target="_blank" rel="noopener">GitHub Releases</a>　备用渠道，国内访问可能较慢</p>
              <p class="dl-alt-tip">国内加速：在 GitHub 的 APK 下载链接前拼接镜像前缀——</p>
              <code class="code">{MIRROR}</code>
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- ====== FAQ ====== -->
    <section id="faq">
      <div class="wrap">
        <div class="sec-head">
          <span class="eyebrow">FAQ</span>
          <h2>常见问题</h2>
        </div>
        <div class="faq">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}<span class="pm"></span></summary>
              <p class="faq-a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ============ hero ============ */
  .hero { padding: 74px 0 80px; position: relative; }
  .hero-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 26px; align-items: center; }
  .hero-copy { grid-column: span 7; animation: rise 0.7s var(--ease) both; }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--blue-soft);
    border: 1px solid rgba(31, 102, 184, 0.32);
    background: rgba(42, 120, 214, 0.07);
    padding: 6px 14px;
    border-radius: 999px;
    margin-bottom: 22px;
  }
  .pill .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 0 rgba(10, 129, 10, 0.5);
    animation: pulse 2.2s infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(10, 129, 10, 0.4); }
    70% { box-shadow: 0 0 0 8px rgba(10, 129, 10, 0); }
    100% { box-shadow: 0 0 0 0 rgba(10, 129, 10, 0); }
  }
  h1 { font-size: clamp(2.35rem, 5.1vw, 3.7rem); line-height: 1.13; letter-spacing: -0.015em; font-weight: 800; }
  h1 .grad {
    background: linear-gradient(92deg, var(--blue-2) 10%, var(--violet) 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .sub { margin-top: 18px; font-size: 1.1rem; color: var(--ink-2); line-height: 1.85; max-width: 34em; }
  .sub b { color: var(--ink-1); font-weight: 650; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 30px; }
  .meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 0;
    margin-top: 26px;
    font-size: 0.84rem;
    color: var(--ink-3);
  }
  .meta-row .m {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 13px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.8);
  }
  .meta-row .m .ic { width: 14px; height: 14px; color: var(--ink-3); }
  .meta-row .sep { margin: 0 6px; opacity: 0.5; }

  /* hero 迷你 Bento */
  .hero-bento {
    grid-column: span 5;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    animation: rise 0.7s 0.12s var(--ease) both, floaty 7s 1.2s ease-in-out infinite alternate;
  }
  .hb {
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 15px 16px;
    background: linear-gradient(180deg, var(--s2), var(--s1));
    box-shadow: 0 1px 2px rgba(20, 28, 45, 0.04), 0 6px 18px rgba(20, 28, 45, 0.05);
    transition: transform 0.25s var(--ease), border-color 0.25s, box-shadow 0.25s;
  }
  .hb:hover {
    transform: translateY(-3px);
    border-color: var(--line-strong);
    box-shadow: 0 4px 10px rgba(20, 28, 45, 0.05), 0 14px 30px rgba(20, 28, 45, 0.1);
  }
  .hb-wide { grid-column: span 2; }
  .hb-slim { grid-column: span 2; display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .hb .hb-top { display: flex; align-items: center; gap: 9px; font-size: 0.84rem; font-weight: 650; color: var(--ink-2); }
  .hb .hb-top .ic { width: 17px; height: 17px; }
  .hb .chip {
    margin-top: 10px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.74rem;
    color: var(--ink-3);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 3px 10px;
  }
  .hb .chip .ic { width: 12px; height: 12px; }
  .hb .chip.up { color: var(--red); border-color: rgba(208, 59, 59, 0.32); background: rgba(208, 59, 59, 0.06); }
  .hb .chip.dn { color: var(--green); border-color: rgba(10, 129, 10, 0.32); background: rgba(10, 129, 10, 0.06); }
  .vtag { font-size: 0.8rem; color: var(--ink-2); font-weight: 650; font-variant-numeric: tabular-nums; }
  .vtag small { color: var(--ink-3); font-weight: 500; }

  /* ============ bento 拼贴 ============ */
  .bento { display: grid; grid-template-columns: repeat(12, 1fr); grid-auto-rows: minmax(150px, auto); gap: var(--gap); }
  .c-chat { grid-column: span 5; grid-row: span 2; }
  .c-quote { grid-column: span 4; grid-row: span 2; }
  .c-stock { grid-column: span 3; grid-row: span 2; }
  .c-alert { grid-column: span 4; }
  .c-news { grid-column: span 5; }
  .c-blogger { grid-column: span 3; }
  .c-stat { grid-column: span 2; display: flex; flex-direction: column; justify-content: space-between; padding: 18px 20px; min-height: 132px; }
  .sval { font-size: 1.45rem; font-weight: 760; letter-spacing: -0.01em; font-variant-numeric: tabular-nums; }
  .sval small { font-size: 0.85rem; font-weight: 600; color: var(--ink-2); margin-left: 2px; }
  .scap { font-size: 0.74rem; color: var(--ink-3); margin-top: 7px; line-height: 1.5; }
  .sico { position: absolute; top: 16px; right: 16px; width: 17px; height: 17px; color: var(--ink-3); opacity: 0.8; }
  .c-stat.tint-blue { --accS: rgba(31, 102, 184, 0.1); background: linear-gradient(180deg, rgba(42, 120, 214, 0.08), var(--s1)); border-color: rgba(31, 102, 184, 0.22); }
  .c-stat.tint-violet { --accS: rgba(99, 87, 214, 0.1); background: linear-gradient(180deg, rgba(99, 87, 214, 0.08), var(--s1)); border-color: rgba(99, 87, 214, 0.22); }

  /* ============ 图表件 ============ */
  .spark { display: block; width: 100%; height: auto; margin-top: 14px; }
  .spark .gline { stroke: var(--grid); stroke-width: 1; }
  .spark .area { fill: url(#gA); opacity: 0.9; }
  .spark .line { fill: none; stroke: var(--blue); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .spark .dotp { fill: var(--blue-2); }
  .spark .halo { fill: none; stroke: rgba(42, 120, 214, 0.5); stroke-width: 1.5; transform-box: fill-box; transform-origin: center; animation: halo 2.4s ease-out infinite; }
  @keyframes halo {
    0% { transform: scale(1); opacity: 0.9; }
    75% { transform: scale(3.4); opacity: 0; }
    100% { transform: scale(3.4); opacity: 0; }
  }
  .spark-cap { position: absolute; top: 22px; right: 22px; font-size: 0.68rem; color: var(--ink-3); letter-spacing: 0.06em; }
  .idx { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; position: relative; }
  .idx span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.755rem;
    border: 1px solid rgba(0, 0, 0, 0.07);
    border-radius: 9px;
    padding: 5px 10px;
    background: #f6f5f1;
    font-variant-numeric: tabular-nums;
    color: var(--ink-2);
  }
  .idx b { font-weight: 650; color: var(--ink-1); }
  .idx .up { color: var(--red); font-style: normal; }
  .idx .dn { color: var(--green); font-style: normal; }
  .peak { margin-top: 14px; position: relative; }
  .peak-lab { display: flex; justify-content: space-between; font-size: 0.7rem; color: var(--ink-3); margin-bottom: 7px; }
  .peak-bars { display: flex; align-items: flex-end; gap: 3px; height: 32px; }
  .peak-bars i { flex: 1; border-radius: 3px 3px 2px 2px; background: rgba(42, 120, 214, 0.22); min-height: 3px; }
  .peak-bars i.hot { background: var(--blue-2); }
  .peak-bars i.warm { background: #86b6ef; }

  /* ============ 聊天 mock ============ */
  .mock {
    margin-top: 15px;
    background: #f4f3ef;
    border: 1px solid rgba(0, 0, 0, 0.07);
    border-radius: var(--r-md);
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .msg { max-width: 88%; padding: 9px 13px; border-radius: 14px; font-size: 0.845rem; line-height: 1.6; }
  .msg.user { align-self: flex-end; background: #ecebe6; color: var(--ink-2); border-bottom-right-radius: 5px; }
  .msg.ai {
    align-self: flex-start;
    background: rgba(42, 120, 214, 0.08);
    color: #17457e;
    border: 1px solid rgba(31, 102, 184, 0.22);
    border-bottom-left-radius: 5px;
  }
  .typing { display: inline-flex; gap: 4px; margin-left: 4px; vertical-align: middle; }
  .typing i { width: 5px; height: 5px; border-radius: 50%; background: var(--blue); animation: blink 1.15s infinite; }
  .typing i:nth-child(2) { animation-delay: 0.18s; }
  .typing i:nth-child(3) { animation-delay: 0.36s; }
  @keyframes blink {
    0%, 70%, 100% { opacity: 0.25; transform: translateY(0); }
    35% { opacity: 1; transform: translateY(-2px); }
  }
  .think { display: flex; align-items: center; gap: 9px; font-size: 0.73rem; color: var(--ink-3); padding: 0 2px; }
  .think .bar { flex: 1; height: 5px; border-radius: 3px; background: rgba(31, 102, 184, 0.16); position: relative; overflow: hidden; }
  .think .bar::before { content: ""; position: absolute; inset: 0; width: 62%; border-radius: 3px; background: linear-gradient(90deg, var(--blue-deep), var(--blue)); }
  .think .bar::after {
    content: "";
    position: absolute;
    inset: 0;
    width: 40%;
    border-radius: 3px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    animation: shimmer 1.9s infinite;
  }
  @keyframes shimmer {
    0% { transform: translateX(-120%); }
    100% { transform: translateX(320%); }
  }
  .cap-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; position: relative; }
  .cap-chips span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.735rem;
    color: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4.5px 11px;
    background: rgba(255, 255, 255, 0.75);
    transition: border-color 0.2s, color 0.2s;
  }
  .cap-chips span:hover { border-color: rgba(31, 102, 184, 0.45); color: var(--blue-soft); }
  .cap-chips .ic { width: 13px; height: 13px; }

  /* ============ 报告 / 通知 / 时间线 / 知识库 mock ============ */
  .report {
    margin-top: 14px;
    border: 1px solid rgba(99, 87, 214, 0.26);
    background: rgba(99, 87, 214, 0.05);
    border-radius: var(--r-md);
    padding: 13px;
    position: relative;
  }
  .r-top { display: flex; align-items: center; gap: 8px; font-size: 0.78rem; color: #5a4bd0; font-weight: 600; }
  .r-badge { font-size: 0.66rem; font-weight: 700; color: #fff; background: var(--violet); border-radius: 6px; padding: 2px 7px; }
  .sk { height: 7px; border-radius: 4px; background: rgba(0, 0, 0, 0.08); margin-top: 9px; }
  .sk.v { background: rgba(99, 87, 214, 0.28); }
  .r-foot { display: flex; justify-content: space-between; margin-top: 11px; font-size: 0.7rem; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .notif {
    margin-top: 14px;
    display: flex;
    align-items: center;
    gap: 11px;
    border: 1px solid rgba(188, 74, 16, 0.3);
    background: rgba(188, 74, 16, 0.05);
    border-radius: var(--r-md);
    padding: 11px 13px;
    position: relative;
  }
  .notif .nb { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; flex: none; background: rgba(188, 74, 16, 0.12); color: #bc4a10; }
  .notif .nb .ic { width: 18px; height: 18px; }
  .cell--orange:hover .notif .nb .ic { animation: swing 0.7s ease-in-out; }
  @keyframes swing {
    0%, 100% { transform: rotate(0); }
    25% { transform: rotate(-14deg); }
    60% { transform: rotate(11deg); }
  }
  .notif .nt { font-size: 0.8rem; font-weight: 650; }
  .notif .ns { font-size: 0.72rem; color: var(--ink-3); margin-top: 2px; }
  .notif .live { margin-left: auto; width: 8px; height: 8px; border-radius: 50%; background: #d95926; animation: pulse2 1.8s infinite; flex: none; }
  @keyframes pulse2 {
    0% { box-shadow: 0 0 0 0 rgba(217, 89, 38, 0.45); }
    70% { box-shadow: 0 0 0 7px rgba(217, 89, 38, 0); }
    100% { box-shadow: 0 0 0 0 rgba(217, 89, 38, 0); }
  }
  .tl { display: flex; justify-content: space-between; position: relative; margin-top: 18px; padding: 2px 10px 0; }
  .tl::before {
    content: "";
    position: absolute;
    left: 30px;
    right: 30px;
    top: 19px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, rgba(138, 97, 0, 0.16), rgba(111, 76, 0, 0.45), rgba(138, 97, 0, 0.16));
  }
  .tl .node { display: flex; flex-direction: column; align-items: center; gap: 8px; position: relative; z-index: 1; width: 64px; }
  .tl .nd {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: rgba(138, 97, 0, 0.08);
    border: 1px solid rgba(111, 76, 0, 0.3);
    color: #6f4c00;
    transition: transform 0.25s var(--ease), box-shadow 0.25s;
  }
  .tl .node:hover .nd { transform: translateY(-2px) scale(1.06); box-shadow: 0 0 0 4px rgba(138, 97, 0, 0.14); }
  .tl .nd .ic { width: 17px; height: 17px; }
  .tl .node.mid .nd { background: rgba(138, 97, 0, 0.16); border-color: rgba(111, 76, 0, 0.5); color: #8a6100; }
  .tl .nl { font-size: 0.76rem; font-weight: 650; color: var(--ink-2); }
  .pf { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 14px; position: relative; }
  .pf span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.74rem;
    color: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 11px;
    background: rgba(255, 255, 255, 0.75);
  }
  .pf i { width: 7px; height: 7px; border-radius: 50%; flex: none; }
  .kb { margin-top: 14px; display: flex; align-items: center; gap: 9px; position: relative; color: var(--ink-3); }
  .kb .ic { width: 14px; height: 14px; flex: none; }
  .kb .kbs { flex: 1; display: flex; flex-direction: column; gap: 6px; }
  .kb .sk { margin-top: 0; height: 6px; }

  /* ============ 三档等级 ============ */
  .plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 34px; align-items: stretch; }
  .plan {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: linear-gradient(180deg, var(--s2), var(--s1));
    padding: 28px 26px;
    box-shadow: 0 1px 2px rgba(20, 28, 45, 0.04), 0 10px 28px rgba(20, 28, 45, 0.06);
    display: flex;
    flex-direction: column;
    transition: transform 0.25s var(--ease), border-color 0.25s, box-shadow 0.25s;
  }
  .plan:hover { transform: translateY(-4px); border-color: var(--line-strong); box-shadow: 0 18px 40px rgba(20, 28, 45, 0.12); }
  .plan--hot {
    border-color: rgba(31, 102, 184, 0.45);
    background: linear-gradient(180deg, rgba(42, 120, 214, 0.07), rgba(42, 120, 214, 0.02) 46%, var(--s1));
    box-shadow: 0 14px 36px rgba(31, 102, 184, 0.14);
  }
  .plan--hot:hover { border-color: rgba(31, 102, 184, 0.7); box-shadow: 0 20px 44px rgba(31, 102, 184, 0.2); }
  .plan--hot::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(420px 160px at 80% -12%, rgba(42, 120, 214, 0.14), transparent 62%);
  }
  .badge {
    position: absolute;
    top: 15px;
    right: 15px;
    font-size: 0.72rem;
    font-weight: 750;
    background: linear-gradient(135deg, var(--blue), var(--blue-deep));
    color: #fff;
    padding: 4.5px 12px;
    border-radius: 999px;
    box-shadow: 0 6px 16px rgba(31, 102, 184, 0.32);
  }
  .tname { font-size: 1.12rem; font-weight: 760; display: flex; align-items: center; gap: 10px; }
  .tier {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    border: 1px solid var(--line-strong);
    border-radius: 7px;
    padding: 2px 8px;
    font-variant-numeric: tabular-nums;
  }
  .plan--hot .tier { color: var(--blue-soft); border-color: rgba(31, 102, 184, 0.4); }
  .tdesc { font-size: 0.8rem; color: var(--ink-3); margin-top: 6px; }
  .plan ul { list-style: none; margin-top: 18px; flex: 1; }
  .plan li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    padding: 9.5px 0;
    border-bottom: 1px dashed rgba(0, 0, 0, 0.1);
    font-size: 0.88rem;
    color: var(--ink-2);
    line-height: 1.55;
  }
  .plan li:last-child { border-bottom: none; }
  .plan li .ic { width: 16px; height: 16px; margin-top: 3px; color: var(--ink-3); }
  .plan--hot li .ic { color: var(--blue-2); }
  .plan .btn { margin-top: 20px; width: 100%; }

  /* ============ 下载 ============ */
  .dl-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: var(--gap); }
  .dl-main { grid-column: span 7; }
  .dl-qr { grid-column: span 5; display: grid; grid-template-columns: auto 1fr; gap: 22px; align-items: center; }
  .dl-help { grid-column: span 7; }
  .dl-more { grid-column: span 5; }

  /* 主按钮：下载板块唯一强 CTA（蓝系实心渐变 · 白字 · 56px 高） */
  .dl-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
    min-height: 56px;
    margin-top: 22px;
    padding: 0 28px;
    border-radius: 16px;
    background: linear-gradient(135deg, var(--blue-2), var(--blue-deep));
    color: #fff;
    font-size: 1.1rem;
    font-weight: 750;
    letter-spacing: 0.01em;
    box-shadow: 0 10px 26px rgba(31, 102, 184, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.28);
    transition: transform 0.22s var(--ease), box-shadow 0.22s var(--ease);
  }
  .dl-btn .ic { width: 22px; height: 22px; }
  .dl-btn:hover { transform: translateY(-2px); box-shadow: 0 14px 32px rgba(31, 102, 184, 0.38), inset 0 1px 0 rgba(255, 255, 255, 0.28); }
  .dl-ver { margin-top: 12px; font-size: 0.8rem; color: var(--ink-3); font-variant-numeric: tabular-nums; position: relative; }

  /* 扫码格（qrSvg 构建期注入，内部 svg 用 :global 命中） */
  .qr-box {
    flex: none;
    width: max-content;
    padding: 9px;
    background: #fff;
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    box-shadow: 0 1px 2px rgba(20, 28, 45, 0.05);
  }
  .qr { width: 125px; height: 125px; }
  .qr :global(svg) { display: block; width: 100%; height: 100%; }
  .qr-txt h3 { font-size: 1.05rem; font-weight: 730; position: relative; }
  .qr-txt p { margin-top: 8px; font-size: 0.84rem; color: var(--ink-3); position: relative; }

  /* 折叠格（安装指引 / 其他下载方式） */
  .dl-fold { padding: 16px 20px; }
  .dl-fold summary { cursor: pointer; list-style: none; display: flex; align-items: center; gap: 10px; font-size: 0.98rem; font-weight: 650; position: relative; }
  .dl-fold summary::-webkit-details-marker { display: none; }
  .dl-fold summary:focus-visible { outline-offset: -2px; }
  .dl-fold .pm { margin-left: auto; }
  .dl-fold[open] { border-color: rgba(31, 102, 184, 0.35); }
  .dl-fold .fbody { padding: 4px 0; animation: faqIn 0.32s var(--ease); }
  .dl-steps { list-style: none; display: flex; flex-direction: column; gap: 9px; margin-top: 4px; }
  .dl-steps li { display: flex; gap: 11px; align-items: flex-start; font-size: 0.875rem; color: var(--ink-2); line-height: 1.7; }
  .dl-steps .n {
    flex: none;
    width: 21px;
    height: 21px;
    margin-top: 2px;
    border-radius: 7px;
    display: grid;
    place-items: center;
    font-size: 0.72rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--blue-2);
    background: rgba(42, 120, 214, 0.09);
    border: 1px solid rgba(31, 102, 184, 0.24);
  }
  .dl-alt p { font-size: 0.875rem; color: var(--ink-2); line-height: 1.8; }
  .dl-alt .dl-gh { color: var(--ink-2); text-decoration: underline; text-decoration-color: rgba(0, 0, 0, 0.28); text-underline-offset: 3px; }
  .dl-alt .dl-gh:hover { color: var(--ink-1); }
  .dl-alt-tip { margin-top: 10px; font-size: 0.8rem; color: var(--ink-3); }
  .code {
    display: block;
    margin-top: 8px;
    font-size: 0.85rem;
    letter-spacing: 0.01em;
    font-family: var(--mono);
    color: var(--ink-2);
    background: #f6f5f1;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    padding: 9px 13px;
    overflow-x: auto;
    white-space: nowrap;
    position: relative;
  }

  /* ============ FAQ ============ */
  .faq { display: flex; flex-direction: column; gap: 10px; margin-top: 30px; max-width: 820px; }
  .faq details {
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: linear-gradient(180deg, var(--s2), var(--s1));
    padding: 0 20px;
    box-shadow: 0 1px 2px rgba(20, 28, 45, 0.03);
    transition: border-color 0.25s, background 0.25s;
  }
  .faq details:hover { border-color: var(--line-strong); }
  .faq details[open] { border-color: rgba(31, 102, 184, 0.4); background: linear-gradient(180deg, rgba(42, 120, 214, 0.05), var(--s1)); }
  .faq summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 17px 0;
    font-weight: 650;
    font-size: 0.96rem;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary:focus-visible { outline-offset: -2px; }
  .faq-a { padding: 0 42px 19px 0; color: var(--ink-2); font-size: 0.9rem; line-height: 1.9; animation: faqIn 0.32s var(--ease); }
  @keyframes faqIn {
    from { opacity: 0; transform: translateY(-5px); }
    to { opacity: 1; transform: none; }
  }

  /* ============ 动效 ============ */
  @keyframes rise {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes floaty {
    from { transform: translateY(0); }
    to { transform: translateY(-7px); }
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @supports (animation-timeline: view()) {
    .bento > .cell,
    .plan,
    .dl-main,
