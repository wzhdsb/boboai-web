---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Aurora from "../components/Aurora.astro";
import { VERSION, VCODE, APK, GITHUB, MIRROR, SHA256 } from "../config";

const SHA256_SHORT = `${SHA256.slice(0, 16)}…`;

// ===== 内容数组：改文案只改这里 =====
const features = [
  {
    cls: "cell--blue c-chat",
    icon: "chat",
    title: "AI 对话",
    tag: "GLM 大模型直连",
    body: "语音输入、拍照识图、多会话管理。快速应答模式约三倍提速，深度思考进度实时可见。",
    mock: "chat",
  },
  {
    cls: "cell--red c-quote",
    icon: "candle",
    title: "实时行情",
    tag: "A股 + 美股",
    body: "指数分时、个股 K 线、筹码峰，盘中秒级刷新；自选与持仓一处管理。",
    mock: "quote",
  },
  {
    cls: "cell--violet c-stock",
    icon: "doc",
    title: "AI 个股分析",
    tag: "深度研究模式",
    body: "多轮推演、消息面联动、结论前置的个股体检报告，思考与开销全程透明。",
    mock: "report",
  },
  {
    cls: "cell--orange c-alert",
    icon: "bell",
    title: "盘中提醒",
    body: "买卖点条件触发，高优通知横幅 + 响铃，后台保活不漏单；预判贴合自动回验，越用越准。",
    mock: "notif",
  },
  {
    cls: "cell--gold c-news",
    icon: "news",
    title: "消息面日报",
    tag: "每日三档（盘前 / 午间 / 盘后）",
    body: "AI 日报：快讯映射板块、传闻雷达、明日看点，积攒你的盘感。",
    mock: "timeline",
  },
  {
    cls: "cell--magenta c-blogger",
    icon: "at",
    title: "博主情报",
    body: "博主动态定时抓取，AI 总结历史脉络，沉淀为可检索的专属知识库。",
    mock: "kb",
  },
];

// 行尾数据小格
const stats = [
  { icon: "android", value: "Android 11+", cap: "无需 root · API 30" },
  { icon: "box", pre: "约 ", value: "17MB", cap: "安装包体积" },
  { icon: "clock", value: "7 天", unit: "试用", cap: "新用户全功能", tint: "tint-blue" },
  { icon: "layers", value: VERSION, cap: `versionCode ${VCODE}`, tint: "tint-violet" },
  { icon: "at", value: "4 平台", unit: "博主", cap: "微博 / B站 / 小红书 / 抖音" },
  { icon: "news", value: "三档", unit: "日报", cap: "盘前 / 午间 / 盘后" },
];

const tiers = [
  {
    name: "基础版",
    tag: "V0",
    hot: false,
    desc: "开箱即用的日常主力",
    items: ["AI 对话·识图·语音", "实时行情与自选持仓", "盘中买卖点提醒", "本地备份与恢复"],
    cta: "订阅基础版",
  },
  {
    name: "情报版",
    tag: "V1",
    hot: false,
    desc: "把博主情报装进口袋",
    items: ["基础版全部功能", "多平台博主情报", "定时轮询与提醒", "专属知识库"],
    cta: "订阅情报版",
  },
  {
    name: "旗舰版",
    tag: "V2",
    hot: true,
    desc: "全能力 · 越用越懂你",
    items: ["情报版全部功能", "每日三档消息面日报", "AI 深度个股分析", "预判回验与错案反哺"],
    cta: "订阅旗舰版",
  },
];

const faqs = [
  {
    q: "需要什么配置的手机？",
    a: "Android 11（API 30）及以上，无需 root。安装包约 17MB，建议 6GB 以上内存的机型以获得流畅的后台体验。",
  },
  {
    q: "免费试用怎么算？",
    a: "首次启动起 7 天全功能试用，无需注册账号。到期后输入激活码解锁，换机可自助换绑设备。",
  },
  {
    q: "我的数据存在哪里？",
    a: "聊天、自选、持仓、知识库全部本地存储，支持口令加密的一键备份导出；不经任何第三方服务器。",
  },
  {
    q: "AI 能力需要自己提供 Key 吗？",
    a: "是。对话与分析使用你自己的智谱 API Key，额度与花销自己掌控，App 内透明记账，不经过中间商。",
  },
  {
    q: "激活后能离线用吗？",
    a: "能。激活票据本地 Ed25519 验签，离线可用；联网时每 24 小时自动静默续签，无需反复输码。",
  },
];
---

<Layout title="BOBO AI 助理 — 住进手机里的 AI 助理">
  <Aurora strength="full" />
  <Nav />

  <!-- ====== Hero ====== -->
  <header class="hero" id="top">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="pill"><span class="dot"></span>{VERSION} · 现已发布</span>
        <h1>住进手机里的<br /><span class="grad">AI 助理</span></h1>
        <p class="sub">看得懂屏幕，读得懂行情，追得上博主。<br /><b>GLM 大模型 × 无障碍 × 数据全本地。</b></p>
        <div class="cta-row">
          <a class="btn btn-primary" href={APK}>
            <svg class="ic" aria-hidden="true"><use href="#i-dl" /></svg>立即下载
          </a>
          <a class="btn btn-ghost" href="#features">了解功能</a>
        </div>
        <div class="meta-row">
          <span class="m"><svg class="ic" aria-hidden="true"><use href="#i-android" /></svg>Android 11+</span><span class="sep">·</span>
          <span class="m"><svg class="ic" aria-hidden="true"><use href="#i-box" /></svg>约 17MB</span><span class="sep">·</span>
          <span class="m"><svg class="ic" aria-hidden="true"><use href="#i-clock" /></svg>新用户 7 天全功能试用</span>
        </div>
      </div>

      <!-- Hero 右侧：迷你 Bento 拼贴 -->
      <div class="hero-bento" aria-hidden="true">
        <div class="hb hb-wide">
          <div class="hb-top" style="color:#d03b3b"><svg class="ic"><use href="#i-candle" /></svg>实时行情 · A股 + 美股</div>
          <svg class="spark" viewBox="0 0 200 56" role="img">
            <path class="area" d="M0 40 L16 34 L32 38 L48 28 L64 32 L80 22 L96 26 L112 18 L128 22 L144 12 L160 16 L176 9 L192 6 L200 5 L200 56 L0 56 Z"/>
            <path class="line" pathLength="1" d="M0 40 L16 34 L32 38 L48 28 L64 32 L80 22 L96 26 L112 18 L128 22 L144 12 L160 16 L176 9 L192 6 L200 5"/>
            <circle class="dotp" cx="192" cy="6" r="2.6"/>
            <g class="halo"><circle cx="192" cy="6" r="3.4"/></g>
          </svg>
          <div style="display:flex;gap:8px;flex-wrap:wrap">
            <span class="chip up">上证 +0.86% ▲</span>
            <span class="chip dn">纳指 −0.42% ▼</span>
          </div>
        </div>
        <div class="hb">
          <div class="hb-top" style="color:#1f66b8"><svg class="ic"><use href="#i-chat" /></svg>AI 对话</div>
          <span class="chip"><svg class="ic"><use href="#i-zap" /></svg>快速应答 · 约 3× 提速</span>
        </div>
        <div class="hb">
          <div class="hb-top" style="color:#c2551d"><svg class="ic"><use href="#i-bell" /></svg>盘中提醒</div>
          <span class="chip"><span style="width:6px;height:6px;border-radius:50%;background:#d95926;display:inline-block"></span>买卖点条件触发</span>
        </div>
        <div class="hb hb-slim">
          <span class="vtag">{VERSION} <small>· versionCode {VCODE}</small></span>
          <span class="chip" style="margin-top:0"><svg class="ic"><use href="#i-cloud" /></svg>应用内更新</span>
        </div>
      </div>
    </div>
  </header>

  <main>
    <!-- ====== 功能 Bento ====== -->
    <section id="features">
      <div class="wrap">
        <div class="sec-head">
          <span class="eyebrow">Features</span>
          <h2>一屏拼贴，各就各位</h2>
          <p class="sec-sub">六大能力按便当盒网格各占一格：大格放主功能，小格放数据点，每格独立材质与底色。</p>
        </div>

        <div class="bento">
          {features.map((f) => (
            <article class={`cell acc ${f.cls}`}>
              <div class="cell-head">
                <span class="ico"><svg class="ic" aria-hidden="true"><use href={`#i-${f.icon}`} /></svg></span>
                <div>
                  <h3>{f.title}</h3>
                  {f.tag && <span class="tag">{f.tag}</span>}
                </div>
              </div>

              {f.mock === "chat" && (
                <Fragment>
                  <p class="body">{f.body}</p>
                  <div class="mock" aria-hidden="true">
                    <div class="msg user">帮我看看今天的有色板块</div>
                    <div class="msg ai">正在深度思考<span class="typing"><i></i><i></i><i></i></span></div>
                    <div class="think"><span>深度思考</span><span class="bar"></span><span>62%</span></div>
                    <div class="msg ai">已切入快速应答模式，这轮解读约 2 秒出稿。</div>
                  </div>
                  <div class="cap-chips">
                    <span><svg class="ic" aria-hidden="true"><use href="#i-mic" /></svg>语音输入</span>
                    <span><svg class="ic" aria-hidden="true"><use href="#i-cam" /></svg>拍照识图</span>
                    <span><svg class="ic" aria-hidden="true"><use href="#i-layers" /></svg>多会话管理</span>
                  </div>
                </Fragment>
              )}

              {f.mock === "quote" && (
                <Fragment>
                  <span class="spark-cap">指数分时 · 示意</span>
                  <svg class="spark" viewBox="0 0 320 96" role="img" aria-label="指数分时走势示意图">
                    <line class="gline" x1="0" y1="24" x2="320" y2="24"/>
                    <line class="gline" x1="0" y1="48" x2="320" y2="48"/>
                    <line class="gline" x1="0" y1="72" x2="320" y2="72"/>
                    <path class="area" d="M0 62 L24 54 L48 58 L72 44 L96 50 L120 38 L144 42 L168 30 L192 34 L216 24 L240 28 L264 18 L288 22 L312 12 L320 10 L320 96 L0 96 Z"/>
                    <path class="line" pathLength="1" d="M0 62 L24 54 L48 58 L72 44 L96 50 L120 38 L144 42 L168 30 L192 34 L216 24 L240 28 L264 18 L288 22 L312 12 L320 10"/>
                    <circle class="dotp" cx="312" cy="12" r="3"/>
                    <g class="halo"><circle cx="312" cy="12" r="3.6"/></g>
                  </svg>
                  <div class="idx" aria-hidden="true">
                    <span>上证指数 <b>3,286.40</b> <em class="up">+0.86% ▲</em></span>
                    <span>深证成指 <b>10,514.27</b> <em class="up">+1.12% ▲</em></span>
                    <span>纳斯达克 <b>17,842.60</b> <em class="dn">−0.42% ▼</em></span>
                    <span>道琼斯 <b>41,238.15</b> <em class="up">+0.15% ▲</em></span>
                  </div>
                  <div class="peak" aria-hidden="true">
                    <div class="peak-lab"><span>筹码峰</span><span>盘中秒级刷新</span></div>
                    <div class="peak-bars">
                      <i style="height:22%"></i><i style="height:30%"></i><i style="height:42%"></i><i style="height:60%"></i>
                      <i class="warm" style="height:76%"></i><i class="warm" style="height:90%"></i><i class="hot" style="height:97%"></i>
                      <i class="warm" style="height:88%"></i><i style="height:72%"></i><i style="height:58%"></i>
                      <i style="height:44%"></i><i style="height:33%"></i><i style="height:25%"></i><i style="height:19%"></i>
                    </div>
                  </div>
                  <p class="body">{f.body}</p>
                </Fragment>
              )}

              {f.mock === "report" && (
                <Fragment>
                  <p class="body">{f.body}</p>
                  <div class="report" aria-hidden="true">
                    <div class="r-top"><span class="r-badge">结论前置</span>个股体检报告 · 示意</div>
                    <div class="sk v" style="width:82%"></div>
                    <div class="sk" style="width:58%"></div>
                    <div class="r-foot"><span>多轮推演 · 消息面联动</span><span>开销透明</span></div>
                  </div>
                </Fragment>
              )}

              {f.mock === "notif" && (
                <Fragment>
                  <div class="notif" aria-hidden="true">
                    <span class="nb"><svg class="ic"><use href="#i-bell" /></svg></span>
                    <div><div class="nt">高优通知横幅 + 响铃</div><div class="ns">买卖点条件触发 · 后台保活不漏单</div></div>
                    <span class="live"></span>
                  </div>
                  <p class="body">{f.body}</p>
                </Fragment>
              )}

              {f.mock === "timeline" && (
                <Fragment>
                  <div class="tl" aria-hidden="true">
                    <div class="node"><span class="nd"><svg class="ic"><use href="#i-sun" /></svg></span><span class="nl">盘前</span></div>
                    <div class="node mid"><span class="nd"><svg class="ic"><use href="#i-news" /></svg></span><span class="nl">午间</span></div>
                    <div class="node"><span class="nd"><svg class="ic"><use href="#i-clock" /></svg></span><span class="nl">盘后</span></div>
                  </div>
                  <p class="body">{f.body}</p>
                </Fragment>
              )}

              {f.mock === "kb" && (
                <Fragment>
                  <div class="pf" aria-hidden="true">
                    <span><i style="background:#d03b3b"></i>微博</span>
                    <span><i style="background:#1f66b8"></i>B站</span>
                    <span><i style="background:#b23a68"></i>小红书</span>
                    <span><i style="background:#199e70"></i>抖音</span>
                  </div>
                  <p class="body">{f.body}</p>
                  <div class="kb" aria-hidden="true">
                    <svg class="ic"><use href="#i-search" /></svg>
                    <div class="kbs"><div class="sk" style="width:74%"></div><div class="sk" style="width:46%"></div></div>
                  </div>
                </Fragment>
              )}
            </article>
          ))}

          {stats.map((s) => (
            <div class={`cell c-stat ${s.tint ?? ""}`}>
              <svg class="sico" aria-hidden="true"><use href={`#i-${s.icon}`} /></svg>
              <div>
                <div class="sval">{s.pre && <small>{s.pre}</small>}{s.value}{s.unit && <small>{s.unit}</small>}</div>
                <div class="scap">{s.cap}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ====== 三档等级 ====== -->
    <section id="plans">
      <div class="wrap">
        <div class="sec-head">
          <span class="eyebrow">Editions</span>
          <h2>三档等级</h2>
          <p class="sec-sub">旗舰版 V2 为推荐档：全能力开放，预判回验与错案反哺持续进化。已订阅低档？随时补差价升级。</p>
        </div>
        <div class="plans">
          {tiers.map((t) => (
            <article class={`plan ${t.hot ? "plan--hot" : ""}`}>
              {t.hot && <span class="badge">推荐</span>}
              <div class="tname">{t.name}<span class="tier">{t.tag}</span></div>
              <p class="tdesc">{t.desc}</p>
              <ul>
                {t.items.map((i) => (
                  <li><svg class="ic" aria-hidden="true"><use href="#i-check" /></svg>{i}</li>
                ))}
              </ul>
              <a class={`btn ${t.hot ? "btn-primary" : "btn-ghost"} btn-sm`} href="/pricing/">
                {t.hot && <svg class="ic" aria-hidden="true"><use href="#i-zap" /></svg>}{t.cta}
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ====== 下载 ====== -->
    <section id="download">
      <div class="wrap">
        <div class="sec-head">
          <span class="eyebrow">Download</span>
          <h2>下载安装</h2>
          <p class="sec-sub">官网直链为主，GitHub 作备用；一次安装，往后交给应用内更新。</p>
        </div>
        <div class="dl-grid">
          <!-- 主下载格：官网直链（唯一强 CTA） -->
          <article class="cell acc cell--blue dl-main">
            <div class="cell-head">
              <span class="ico"><svg class="ic" aria-hidden="true"><use href="#i-dl" /></svg></span>
              <div><h3>官网直链下载</h3><span class="tag">推荐 · 无需跳转第三方</span></div>
            </div>
            <a class="dl-btn" href={APK} download>
              <svg class="ic" aria-hidden="true"><use href="#i-dl" /></svg>下载 APK · {VERSION}
            </a>
            <p class="dl-ver">版本 {VERSION}（versionCode {VCODE}）· 约 17MB · Android 11+</p>
            <details class="dl-hash">
              <summary>
                <span class="lab">SHA256</span>
                <code>{SHA256_SHORT}</code>
                <span class="pm"></span>
              </summary>
              <div class="fbody">
                <code class="dl-hash-full">{SHA256}</code>
                <p class="dl-hash-tip">下载后可校验完整性：Windows 在 PowerShell 里运行 certutil -hashfile 文件名 SHA256；macOS / Linux 运行 shasum -a 256 文件名。</p>
              </div>
            </details>
          </article>

          <!-- 扫码格 -->
          <article class="cell dl-qr">
            <div class="qr-box">
              <!-- 占位：手绘"二维码样式"装饰图案，未做真实编码；正式版换真码，指向与主按钮相同的下载直链 -->
              <svg class="qr" viewBox="0 0 25 25" role="img" aria-label="扫码下载二维码（占位图案）" shape-rendering="crispEdges">
                <rect width="25" height="25" fill="#ffffff"/>
                <path class="qr-f" fill-rule="evenodd" d="M0 0h7v7H0z M2 2h3v3H2z M18 0h7v7h-7z M20 2h3v3H20z M0 18h7v7H0z M2 20h3v3H2z M16 16h5v5h-5z M18 18h1v1z"/>
                <path class="qr-f" d="M8 6h1v1z M10 6h1v1z M12 6h1v1z M14 6h1v1z M16 6h1v1z M6 8h1v1z M6 10h1v1z M6 12h1v1z M6 14h1v1z M6 16h1v1z"/>
                <path class="qr-f" d="M7 0h1v1z M9 0h1v1z M10 0h1v1z M13 0h1v1z M16 0h1v1z M17 0h1v1z
                  M8 1h1v1z M12 1h1v1z M14 1h1v1z
                  M7 2h1v1z M9 2h1v1z M11 2h1v1z M15 2h1v1z
                  M10 3h1v1z M13 3h1v1z M16 3h1v1z M17 3h1v1z
                  M8 4h1v1z M12 4h1v1z M15 4h1v1z
                  M7 5h1v1z M9 5h1v1z M14 5h1v1z M16 5h1v1z
                  M0 7h1v1z M2 7h1v1z M3 7h1v1z M7 7h1v1z M9 7h1v1z M11 7h1v1z M14 7h1v1z M17 7h1v1z M19 7h1v1z M20 7h1v1z M23 7h1v1z
                  M1 8h1v1z M4 8h1v1z M7 8h1v1z M10 8h1v1z M13 8h1v1z M18 8h1v1z M21 8h1v1z M24 8h1v1z
                  M0 9h1v1z M2 9h1v1z M5 9h1v1z M8 9h1v1z M12 9h1v1z M15 9h1v1z M19 9h1v1z M22 9h1v1z M24 9h1v1z
                  M3 10h1v1z M7 10h1v1z M9 10h1v1z M11 10h1v1z M16 10h1v1z M20 10h1v1z M23 10h1v1z
                  M1 11h1v1z M4 11h1v1z M10 11h1v1z M13 11h1v1z M17 11h1v1z M21 11h1v1z M24 11h1v1z
                  M0 12h1v1z M2 12h1v1z M8 12h1v1z M14 12h1v1z M18 12h1v1z M19 12h1v1z M22 12h1v1z
                  M5 13h1v1z M7 13h1v1z M11 13h1v1z M15 13h1v1z M20 13h1v1z M23 13h1v1z M24 13h1v1z
                  M1 14h1v1z M3 14h1v1z M9 14h1v1z M12 14h1v1z M16 14h1v1z M21 14h1v1z
                  M0 15h1v1z M4 15h1v1z M8 15h1v1z M13 15h1v1z M17 15h1v1z M19 15h1v1z M22 15h1v1z M24 15h1v1z
                  M1 16h1v1z M4 16h1v1z M8 16h1v1z M10 16h1v1z M13 16h1v1z M15 16h1v1z
                  M2 17h1v1z M5 17h1v1z M9 17h1v1z M12 17h1v1z M14 17h1v1z M21 17h1v1z M23 17h1v1z
                  M7 18h1v1z M10 18h1v1z M12 18h1v1z M15 18h1v1z M21 18h1v1z M24 18h1v1z
                  M8 19h1v1z M11 19h1v1z M14 19h1v1z M22 19h1v1z M23 19h1v1z
                  M7 20h1v1z M9 20h1v1z M13 20h1v1z M21 20h1v1z M24 20h1v1z
                  M8 21h1v1z M10 21h1v1z M13 21h1v1z M16 21h1v1z M18 21h1v1z M20 21h1v1z M23 21h1v1z
                  M7 22h1v1z M11 22h1v1z M14 22h1v1z M17 22h1v1z M19 22h1v1z M24 22h1v1z
