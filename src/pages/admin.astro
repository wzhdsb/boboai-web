---
// ===== 管理台（站长自用，不进导航/页脚/搜索引擎）：密钥门 → 注册用户一览 + 删号 =====
// 零 JS 豁免第三类：连自有后端（license-server /admin/users）的管理数据页。
// ADMIN_KEY 只存本机 localStorage（key `bobo_admin`），与用户 token（bobo_token）分开。
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { LIC } from "../config";
---

<Layout title="管理台 — BOBO AI" noindex>
  <Nav variant="sub" ctaLabel="" />

  <!-- 本页新增图标（与 Layout 全局雪碧图同风格：24 视窗 / stroke 1.7 / round cap）。
       i-lock 顺带补全：下方密钥门一直引用着它，但全局雪碧图里没有这个 symbol。 -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="i-tag" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r="1.4"/></symbol>
    <symbol id="i-lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10.5" width="14" height="10.2" rx="2.6"/><path d="M8.2 10.5V8a3.8 3.8 0 0 1 7.6 0v2.5"/><path d="M12 14.3v2.6"/></symbol>
  </svg>

  <main class="adm" data-api={LIC}>
    <div class="wrap">

      <!-- 密钥门（无密钥 / 密钥失效时亮出） -->
      <div class="gate" id="gate" hidden>
        <div class="cell gate-card">
          <span class="ico"><svg class="ic" aria-hidden="true"><use href="#i-lock" /></svg></span>
          <h3>管理台</h3>
          <p>输入管理密钥，查看注册用户与订阅情况。密钥只存在你这台设备上。</p>
          <form class="key-form" id="key-form">
            <input type="password" id="key" placeholder="管理密钥" autocomplete="off" required />
            <button class="btn btn-primary btn-sm" type="submit"><span>进入</span></button>
          </form>
          <p class="key-err" id="key-err" hidden></p>
        </div>
      </div>

      <!-- 数据面板：用户一览 / 定价编辑 两个页签 -->
      <div class="panel" id="panel" hidden>
        <div class="page-head">
          <span class="eyebrow">Admin</span>
          <h1>管理台</h1>
          <div class="bar">
            <div class="tabs">
              <button class="tab on" id="tab-users" type="button">用户</button>
              <button class="tab" id="tab-pricing" type="button">定价</button>
            </div>
            <span class="upd" id="updated"></span>
            <button class="btn btn-sm" id="reload" type="button">刷新</button>
            <button class="btn btn-sm" id="exit" type="button">退出</button>
          </div>
        </div>

        <!-- 用户一览 -->
        <section id="sec-users">
          <input type="search" id="q" class="usearch" placeholder="按邮箱筛选…" />
          <div class="stats" id="stats"></div>
          <div class="ulist" id="users"></div>

          <!-- 网络异常兜底（密钥保留，可重试） -->
          <div class="gate" id="lerr" hidden>
            <div class="cell gate-card">
              <span class="ico"><svg class="ic" aria-hidden="true"><use href="#i-cloud" /></svg></span>
              <h3>网络异常，数据没拉到</h3>
              <p>密钥还在，多半是线路不稳——重试一下就好。</p>
              <button class="btn btn-primary btn-sm" id="retry" type="button">重试</button>
            </div>
          </div>
        </section>

        <!-- 定价编辑：保存进 license-server（site_config.pricing），订阅页实时生效，无需发版 -->
        <section id="sec-pricing" hidden>
          <div class="cell acc cell--blue pcard">
            <div class="cell-head">
              <span class="ico"><svg class="ic" aria-hidden="true"><use href="#i-tag" /></svg></span>
              <div><h3>原价</h3><span class="tag">三档 × 四周期</span></div>
            </div>
            <p class="ph pcard-lead">单位元，填每档该周期的<b>合计价</b>（3 个月档就填 3 个月一共多少钱）。订阅页大数字按月折算、合计与立省% 自动算。</p>
            <div class="ptab-cap">原价表 · 12 格全部必填</div>
            <div class="ptab" id="pt-base"></div>
            <p class="pstate" id="p-state"></p>
          </div>

          <div class="cell acc cell--magenta pcard pcard--promo">
            <div class="pm-head">
              <div class="cell-head">
                <span class="ico"><svg class="ic" aria-hidden="true"><use href="#i-zap" /></svg></span>
                <div><h3>促销</h3><span class="tag">选配</span></div>
              </div>
              <label class="pm-on"><input type="checkbox" id="pm-on" /><i class="sw" aria-hidden="true"></i><b>启用促销</b></label>
            </div>
            <div id="pm-body">
              <div class="pm-in">
                <div class="pm-grid">
                  <label class="pm-field">
                    <span>活动名</span>
                    <input type="text" id="pm-name" placeholder="订阅页角标显示，如：国庆 8 折" maxlength="24" />
                  </label>
                  <label class="pm-field">
                    <span>到期日（可不填）</span>
                    <input type="date" id="pm-end" />
                  </label>
                </div>
                <p class="ph">启用后订阅页原价划线、旁边显示促销价。到期日当天仍生效、过后自动恢复原价；留空 = 一直生效，取消勾选即停。</p>
                <div class="pm-quick">
                  <span class="pq-lab">快填折扣</span>
                  <span class="pq-in"><input type="number" id="pm-off" min="0.5" max="9.9" step="0.1" placeholder="8" /><i>折</i></span>
                  <button class="btn btn-ghost btn-sm" id="pm-apply" type="button"><svg class="ic" aria-hidden="true"><use href="#i-zap" /></svg>按原价 × 折扣填入促销价</button>
                </div>
                <div class="ptab-cap">促销价表 · 单位元（折后合计）</div>
                <div class="ptab" id="pt-pm"></div>
              </div>
            </div>
          </div>

          <div class="psave">
            <button class="btn btn-primary" id="psave" type="button">保存定价</button>
            <span class="pmsg" id="pmsg"></span>
            <span class="ph psave-hint">保存后订阅页刷新即生效</span>
          </div>
        </section>
      </div>

    </div>
  </main>

  <Footer />

  <script>
    // ===== 管理台数据流：用户页签 POST /admin/users；定价页签 GET /pricing 回填 + POST /admin/pricing 保存 =====
    const API = (document.querySelector(".adm") as HTMLElement).dataset.api!;
    const KEY_NAME = "bobo_admin"; // 与用户会话 bobo_token 分开，退出登录不影响管理台
    const TIER_NAME: Record<number, string> = { 0: "V0 基础版", 1: "V1 情报版", 2: "V2 旗舰版" };

    type Lic = {
      app: string; app_name: string | null; tier: number; plan: string;
      status: string; activated_at: string | null; subscription_expires_at: number | null; devices: number;
    };
    type User = {
      id: number; email: string; status: string; created_at: string; last_login_at: string | null; licenses: Lic[];
    };
    type Data = {
      ok: true;
      stats: { users: number; bound_licenses: number; active_subscriptions: number };
      users: User[];
    };

    const $ = (id: string) => document.getElementById(id)!;
    const esc = (s: string) =>
      s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]!));
    const dateStr = (v: string | number | null | undefined) =>
      v == null ? "—" : new Date(typeof v === "number" ? v * 1000 : v).toISOString().slice(0, 10);

    let data: Data | null = null;

    function statusOf(l: Lic, now: number): "active" | "expired" | "unused" | "revoked" {
      if (l.status === "revoked") return "revoked";
      if (l.status === "unused") return "unused";
      return Number(l.subscription_expires_at ?? 0) > now ? "active" : "expired";
    }

    const ST_CHIP: Record<string, [string, string]> = {
      active: ["ok", "生效中"],
      expired: ["dim", "已到期"],
      unused: ["warn", "未激活"],
      revoked: ["bad", "已吊销"],
    };

    function render() {
      if (!data) return;
      const s = data.stats;
      $("stats").innerHTML = `
        <div class="cell stat"><span class="ico"><svg class="ic" aria-hidden="true"><use href="#i-user" /></svg></span>
          <b>${s.users}</b><span>注册用户</span></div>
        <div class="cell stat"><span class="ico"><svg class="ic" aria-hidden="true"><use href="#i-box" /></svg></span>
          <b>${s.bound_licenses}</b><span>绑定激活码</span></div>
        <div class="cell stat"><span class="ico"><svg class="ic" aria-hidden="true"><use href="#i-zap" /></svg></span>
          <b>${s.active_subscriptions}</b><span>生效订阅</span></div>`;
      renderList();
      $("updated").textContent = `更新于 ${new Date().toTimeString().slice(0, 5)}`;
    }

    function renderList() {
      if (!data) return;
      const q = ($("q") as HTMLInputElement).value.trim().toLowerCase();
      const now = Math.floor(Date.now() / 1000);
      const list = q ? data.users.filter((u) => u.email.toLowerCase().includes(q)) : data.users;
      $("users").innerHTML = list.length
        ? list.map((u) => {
            const lics = u.licenses
              .map((l) => {
                const [cls, txt] = ST_CHIP[statusOf(l, now)] ?? ["dim", l.status];
                return `<span class="lic">
                  <b>${TIER_NAME[l.tier] ?? `V${l.tier}`}</b> · ${esc(l.plan ?? "—")}
                  <i class="chip ${cls}">${txt}</i>
                  到期 ${dateStr(l.subscription_expires_at)} · 设备 ${l.devices} 台
                </span>`;
              })
              .join("");
            return `<div class="cell ucard">
              <div class="u-head">
                <b class="u-mail">${esc(u.email)}</b>
                <i class="chip ${u.status === "active" ? "ok" : "bad"}">${u.status === "active" ? "正常" : "已禁用"}</i>
                <span class="u-meta">#${u.id} · 注册 ${dateStr(u.created_at)} · 最近登录 ${dateStr(u.last_login_at)}</span>
                <button class="del" type="button" data-email="${esc(u.email)}">删除</button>
              </div>
              <div class="u-lics">${lics || '<span class="none">未绑定激活码</span>'}</div>
            </div>`;
          }).join("")
        : `<p class="none">没有匹配「${esc(q)}」的账号。</p>`;
    }

    /** 三态：ok 成功 / unauth 密钥失效（清掉回密钥门）/ err 网络异常（密钥保留可重试） */
    async function load(): Promise<"ok" | "unauth" | "err"> {
      const key = localStorage.getItem(KEY_NAME);
      if (!key) return "unauth";
      try {
        const res = await fetch(`${API}/admin/users`, { method: "POST", headers: { Authorization: `Bearer ${key}` } });
        if (res.status === 401) return "unauth";
        const d = await res.json().catch(() => null);
        if (!res.ok || !d?.ok) return "err";
        data = d;
        render();
        return "ok";
      } catch {
        return "err";
      }
    }

    function showGate() {
      $("gate").hidden = false;
      $("panel").hidden = true;
      $("lerr").hidden = true;
    }

    async function boot() {
      $("gate").hidden = true;
      $("lerr").hidden = true;
      if (!localStorage.getItem(KEY_NAME)) {
        showGate();
        return;
      }
      $("panel").hidden = false;
      const r = await load();
      if (r === "ok") return;
      $("panel").hidden = true;
      if (r === "unauth") {
        localStorage.removeItem(KEY_NAME);
        showGate();
      } else $("lerr").hidden = false;
    }

    // ---- 密钥门：提交即验证，通过才落 localStorage ----
    $("key-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const input = $("key") as HTMLInputElement;
      const err = $("key-err");
      const key = input.value.trim();
      if (!key) return;
      err.hidden = true;
      localStorage.setItem(KEY_NAME, key); // 先放进去让 load() 带上；失败即清
      const r = await load();
      if (r === "ok") {
        input.value = "";
        $("gate").hidden = true;
        $("panel").hidden = false;
      } else {
        localStorage.removeItem(KEY_NAME);
        err.textContent = r === "unauth" ? "密钥不对，再检查一下" : "网络异常，稍后再试";
        err.hidden = false;
      }
    });

    $("q").addEventListener("input", renderList);

    // ---- 删号（POST /admin/user-delete）：确认后执行，激活码解绑保留、会话全清 ----
    async function delUser(email: string, btn: HTMLButtonElement) {
      const n = data?.users.find((u) => u.email === email)?.licenses.length ?? 0;
      if (!confirm(`删除 ${email}？\n· 名下 ${n} 张激活码会解绑（码保留，可再绑别的账号）\n· 该账号立即登出，操作不可恢复`)) return;
      btn.disabled = true;
      btn.textContent = "删除中…";
      try {
        const res = await fetch(`${API}/admin/user-delete`, {
          method: "POST",
          headers: { Authorization: `Bearer ${localStorage.getItem(KEY_NAME)}`, "Content-Type": "application/json" },
          body: JSON.stringify({ email }),
        });
        const d = await res.json().catch(() => null);
        if (res.ok && d?.ok) await load(); // 重拉列表，汇总数同步
        else if (d?.error === "not_found") await load(); // 别处已删过，列表对齐即可
        else alert(d?.error === "rate_limited" ? "操作太频繁，稍等再删" : "删除失败，稍后再试");
      } catch {
        alert("网络异常，稍后再试");
      }
      btn.disabled = false;
      btn.textContent = "删除";
    }
    $("users").addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest(".del") as HTMLButtonElement | null;
      if (btn && !btn.disabled) delUser(btn.dataset.email!, btn);
    });
    $("reload").addEventListener("click", async () => {
      $("reload").textContent = "刷新中…";
      if ($("sec-pricing").hidden) await load();
      else await loadPricing();
      $("reload").textContent = "刷新";
    });
    $("exit").addEventListener("click", () => {
      localStorage.removeItem(KEY_NAME);
      data = null;
      showGate();
    });
    $("retry").addEventListener("click", boot);

    // ===== 定价页签：三档 × 四周期两张表（原价 / 促销价），保存走 POST /admin/pricing =====
    const TIERS: [string, string][] = [["V0", "基础版"], ["V1", "情报版"], ["V2", "旗舰版"]];
    const CYCLES: [string, string][] = [["1m", "1 个月"], ["3m", "3 个月"], ["1y", "1 年"], ["life", "终身"]];
    type Matrix = Record<string, Record<string, number>>;
    let tablesBuilt = false;
    let pricingLoaded = false;

    function buildPriceTable(host: HTMLElement) {
      host.innerHTML =
        `<table class="pgrid"><thead><tr><th class="c-corner">档位 / 周期</th>${CYCLES.map(([, l]) => `<th>${l}</th>`).join("")}</tr></thead><tbody>` +
        TIERS.map(
          ([t, n]) =>
            `<tr><th><span class="tn">${n}</span><i class="tb tb-${t}">${t}</i></th>${CYCLES.map(
              ([c]) => `<td><input type="number" min="0" max="999999" step="0.01" inputmode="decimal" data-k="${t}.${c}" placeholder="—" /></td>`,
            ).join("")}</tr>`,
        ).join("") +
        `</tbody></table>`;
    }

    function fillMatrix(host: HTMLElement, m: Matrix | null) {
      host.querySelectorAll<HTMLInputElement>("input").forEach((i) => {
        const [t, c] = (i.dataset.k ?? "").split(".");
        const v = m?.[t]?.[c];
        i.value = typeof v === "number" ? String(v) : "";
      });
    }

    /** 全 12 格必填、0–999999、最多两位小数；不合格返回 err */
    function readMatrix(host: HTMLElement): { m: Matrix | null; err: string | null } {
      const m: Matrix = {};
      for (const [t] of TIERS) {
        m[t] = {};
        for (const [c] of CYCLES) {
          const raw = host.querySelector<HTMLInputElement>(`input[data-k="${t}.${c}"]`)?.value.trim() ?? "";
          if (raw === "") return { m: null, err: "没填全（三档 × 四周期共 12 个价）" };
          const n = Number(raw);
          if (!Number.isFinite(n) || n < 0 || n > 999999 || Math.round(n * 100) / 100 !== n)
            return { m: null, err: "格式不对（0–999999 元，最多两位小数）" };
          m[t][c] = n;
        }
      }
      return { m, err: null };
    }

    const pmsg = (text: string, bad = false) => {
      const el = $("pmsg");
      el.textContent = text;
      el.classList.toggle("bad", bad);
    };

    function setPmBody(on: boolean) {
      $("pm-body").classList.toggle("dim", !on);
      $("pm-body").querySelectorAll<HTMLInputElement | HTMLButtonElement>("input, button").forEach((el) => (el.disabled = !on));
    }

    async function loadPricing(): Promise<boolean> {
      try {
        const res = await fetch(`${API}/pricing`);
        const d = await res.json().catch(() => null);
        if (!res.ok || !d?.ok) throw new Error();
        pricingLoaded = true;
        const p = d.pricing; // null = 尚未配置
        fillMatrix($("pt-base"), p?.prices ?? null);
        ($("pm-on") as HTMLInputElement).checked = !!p?.promo;
        setPmBody(!!p?.promo);
        ($("pm-name") as HTMLInputElement).value = p?.promo?.name ?? "";
        ($("pm-end") as HTMLInputElement).value = p?.promo?.ends_at ?? "";
        fillMatrix($("pt-pm"), p?.promo?.prices ?? null);
        $("p-state").textContent = p
          ? `已配置 · 更新于 ${String(p.updated_at ?? "").slice(0, 10)}${
              p.promo ? (p.promo_active ? ` · 促销生效中（${p.promo.name}）` : " · 促销未生效（已到期）") : ""
            }`
          : "尚未配置 —— 填好 12 个价格保存后，订阅页即显示正式价（此前维持占位数字）";
        return true;
      } catch {
        $("p-state").textContent = "定价拉取失败，点右上「刷新」重试。";
        return false;
      }
    }

    function showTab(which: "users" | "pricing") {
      $("tab-users").classList.toggle("on", which === "users");
      $("tab-pricing").classList.toggle("on", which === "pricing");
      $("sec-users").hidden = which !== "users";
      $("sec-pricing").hidden = which !== "pricing";
    }

    $("tab-users").addEventListener("click", () => showTab("users"));
    $("tab-pricing").addEventListener("click", async () => {
      showTab("pricing");
      if (!tablesBuilt) {
        buildPriceTable($("pt-base"));
        buildPriceTable($("pt-pm"));
        tablesBuilt = true;
      }
      if (!pricingLoaded) await loadPricing();
    });
    $("pm-on").addEventListener("change", (e) => setPmBody((e.target as HTMLInputElement).checked));

    // 快填：原价 × 折扣（8 = 八折）四舍五入到整数，填完可手改个别档位
    $("pm-apply").addEventListener("click", () => {
      const off = Number(($("pm-off") as HTMLInputElement).value);
      if (!Number.isFinite(off) || off <= 0 || off >= 10) {
        pmsg("折扣填 0.5–9.9，比如 8 = 八折", true);
        return;
      }
      for (const [t] of TIERS)
        for (const [c] of CYCLES) {
          const b = Number($("pt-base").querySelector<HTMLInputElement>(`input[data-k="${t}.${c}"]`)?.value ?? "");
          const el = $("pt-pm").querySelector<HTMLInputElement>(`input[data-k="${t}.${c}"]`);
          if (el && Number.isFinite(b) && b > 0) el.value = String(Math.round((b * off) / 10));
        }
    });

    $("psave").addEventListener("click", async () => {
      const base = readMatrix($("pt-base"));
      if (base.err || !base.m) {
        pmsg(`原价${base.err}`, true);
        return;
      }
      const body: { prices: Matrix; promo: { name: string; prices: Matrix; ends_at: string } | null } = { prices: base.m, promo: null };
      if (($("pm-on") as HTMLInputElement).checked) {
        const pm = readMatrix($("pt-pm"));
        if (pm.err || !pm.m) {
          pmsg(`促销价${pm.err}`, true);
          return;
        }
        const name = ($("pm-name") as HTMLInputElement).value.trim();
        if (!name) {
          pmsg("促销还差活动名（订阅页角标显示它）", true);
          return;
        }
        body.promo = { name, prices: pm.m, ends_at: ($("pm-end") as HTMLInputElement).value };
      }
      const btn = $("psave") as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = "保存中…";
      try {
        const res = await fetch(`${API}/admin/pricing`, {
          method: "POST",
          headers: { Authorization: `Bearer ${localStorage.getItem(KEY_NAME)}`, "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        const d = await res.json().catch(() => null);
        if (res.status === 401) {
          // 密钥失效：恢复按钮再退回密钥门（下次进来按钮是可点的）
          btn.disabled = false;
          btn.textContent = "保存定价";
          localStorage.removeItem(KEY_NAME);
          data = null;
          showGate();
          return;
        }
        if (res.ok && d?.ok) {
          pmsg("已保存 ✓ 订阅页刷新即生效");
          await loadPricing();
        } else pmsg(`保存失败（${d?.error ?? "网络异常"}）`, true);
      } catch {
        pmsg("网络异常，稍后再试", true);
      }
      btn.disabled = false;
      btn.textContent = "保存定价";
    });

    await boot();
  </script>
</Layout>

