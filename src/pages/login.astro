---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Aurora from "../components/Aurora.astro";
import { LIC } from "../config";

// 邮箱+密码 v1（后端 license-server /auth/*，契约见其 API.md）。短信通道待 ICP 备案确认后加。
// 本页带客户端脚本（登录/注册要 fetch 后端）——零 JS 约定的第二类豁免：表单类页面，
// 与 app.astro「连本机资源」不同源，见 CLAUDE.md 豁免注记。
---
<Layout
  title="登录 / 注册 — BOBO AI 助理"
  description="注册或登录 BOBO 账号：邮箱 + 密码，在官网绑定激活码、查看订阅状态。App 数据仍全部本地存储。"
>
  <!-- 极光层：登录页比主页安静一档（soft） -->
  <Aurora strength="soft" />

  <!-- 子页导航：logo 回首页，右上角「返回首页」 -->
  <Nav variant="sub" ctaLabel="返回首页" ctaHref="/" />

  <!-- 本页新增图标（与 Layout 全局雪碧图同风格：24 视窗 / stroke 1.7 / round cap） -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="i-mail" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5.2" width="18" height="13.6" rx="2.4"/><path d="m4.8 7.5 7.2 5.4 7.2-5.4"/></symbol>
    <symbol id="i-lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10.5" width="14" height="10.2" rx="2.6"/><path d="M8.2 10.5V8a3.8 3.8 0 0 1 7.6 0v2.5"/><path d="M12 14.3v2.6"/></symbol>
    <symbol id="i-shield" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.8 5 5.5v5.3c0 4.5 2.9 8.2 7 10.2 4.1-2 7-5.7 7-10.2V5.5L12 2.8Z"/><path d="m9 12 2.2 2.2 4-4.5"/></symbol>
  </svg>

  <!-- ====== 主体：居中单卡 ====== -->
  <main class="auth" data-api={LIC}>

    <!-- 模式 radio：置于卡片之前，CSS 兄弟选择器驱动 tab / 标题 / 表单切换 -->
    <input class="sr" type="radio" name="mode" id="m-login" checked>
    <input class="sr" type="radio" name="mode" id="m-reg">

    <div class="auth-card">

      <!-- 登录 / 注册 tab -->
      <div class="tabs">
        <label for="m-login">登 录</label>
        <label for="m-reg">注 册</label>
        <span class="slider" aria-hidden="true"></span>
      </div>

      <!-- 标题区（随 tab 切换） -->
      <div class="auth-head">
        <div class="head head-login">
          <span class="auth-ico"><svg class="ic" aria-hidden="true"><use href="#i-user"/></svg></span>
          <h1>欢迎回来</h1>
          <p>登录 BOBO 账号，管理激活码与订阅</p>
        </div>
        <div class="head head-reg">
          <span class="auth-ico"><svg class="ic" aria-hidden="true"><use href="#i-logo"/></svg></span>
          <h1>创建账号</h1>
          <p>一个邮箱，官网与后续服务通用</p>
        </div>
      </div>

      <!-- ====== 登录表单（邮箱 + 密码） ====== -->
      <form class="pane pane-login" data-mode="login">
        <div class="field">
          <label class="flabel" for="le">邮箱</label>
          <div class="inp">
            <svg class="ic" aria-hidden="true"><use href="#i-mail"/></svg>
            <input id="le" name="email" type="email" autocomplete="email" autocapitalize="off"
                   placeholder="you@example.com" required maxlength="254">
          </div>
        </div>
        <div class="field">
          <label class="flabel" for="lpw">密码</label>
          <div class="inp">
            <svg class="ic" aria-hidden="true"><use href="#i-lock"/></svg>
            <input id="lpw" name="password" type="password" autocomplete="current-password"
                   placeholder="请输入密码" required minlength="8" maxlength="128">
          </div>
        </div>
        <p class="form-err" hidden></p>
        <button class="btn btn-primary btn-block" type="submit">
          <svg class="ic" aria-hidden="true"><use href="#i-user"/></svg><span>登录</span>
        </button>
      </form>

      <!-- ====== 注册表单（邮箱 + 密码 + 确认） ====== -->
      <form class="pane pane-reg" data-mode="reg">
        <div class="field">
          <label class="flabel" for="re">邮箱</label>
          <div class="inp">
            <svg class="ic" aria-hidden="true"><use href="#i-mail"/></svg>
            <input id="re" name="email" type="email" autocomplete="email" autocapitalize="off"
                   placeholder="you@example.com" required maxlength="254">
          </div>
        </div>
        <div class="field">
          <label class="flabel" for="rpw">设置密码</label>
          <div class="inp">
            <svg class="ic" aria-hidden="true"><use href="#i-lock"/></svg>
            <input id="rpw" name="password" type="password" autocomplete="new-password"
                   placeholder="至少 8 位" required minlength="8" maxlength="128">
          </div>
        </div>
        <div class="field">
          <label class="flabel" for="rpw2">确认密码</label>
          <div class="inp">
            <svg class="ic" aria-hidden="true"><use href="#i-lock"/></svg>
            <input id="rpw2" name="password2" type="password" autocomplete="new-password"
                   placeholder="再输一次" required minlength="8" maxlength="128">
          </div>
        </div>

        <p class="trial">
          <svg class="ic" aria-hidden="true"><use href="#i-shield"/></svg>
          <span>账号用于在官网<b>绑定激活码、查看订阅状态</b>；App 内数据仍全部本地存储，不上传不同步。</span>
        </p>

        <div class="agree">
          <label class="agree-cb">
            <input type="checkbox" name="agree" required>
            <span class="box"><svg class="ic" aria-hidden="true"><use href="#i-check"/></svg></span>
          </label>
          <p class="agree-txt">我已阅读并同意<a href="/privacy/">《隐私政策》</a></p>
        </div>

        <p class="form-err" hidden></p>
        <button class="btn btn-primary btn-block" type="submit">
          <svg class="ic" aria-hidden="true"><use href="#i-zap"/></svg><span>注册</span>
        </button>
      </form>

    </div>

    <!-- 卡片下方小字：打消隐私顾虑 -->
    <p class="under-note">
      <svg class="ic" aria-hidden="true"><use href="#i-android"/></svg>
      App 激活码激活，无需账号也能用
      <span aria-hidden="true">·</span>
      <svg class="ic" aria-hidden="true"><use href="#i-shield"/></svg>
      聊天与行情数据全部本地存储
    </p>

  </main>

  <Footer />

  <script>
    // ===== 登录/注册：fetch license-server（config.ts 的 LIC），token 存 localStorage =====
    const API = (document.querySelector(".auth") as HTMLElement).dataset.api!;
    const TOKEN_KEY = "bobo_token";

    // 已登录（本地有 token）直接进用户中心；token 失效则由 /account/ 踢回来
    if (localStorage.getItem(TOKEN_KEY)) location.replace("/account/");

    // 服务端 error code → 用户能看懂的话
    const ERR_TEXT: Record<string, string> = {
      email_taken: "该邮箱已注册——切到「登 录」直接登录即可",
      bad_credentials: "邮箱或密码不正确",
      bad_email: "邮箱格式好像不对",
      bad_password: "密码至少 8 位",
      rate_limited: "操作太频繁，稍后再试",
      account_disabled: "账号已被禁用，请联系开发者",
    };

    function showErr(form: HTMLFormElement, text: string) {
      const el = form.querySelector(".form-err")!;
      el.textContent = text;
      el.hidden = false;
    }

    document.querySelectorAll<HTMLFormElement>(".pane").forEach((form) => {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const err = form.querySelector(".form-err") as HTMLElement;
        err.hidden = true;
        const email = (form.querySelector('[name="email"]') as HTMLInputElement).value.trim();
        const password = (form.querySelector('[name="password"]') as HTMLInputElement).value;
        const btn = form.querySelector("button[type=submit]") as HTMLButtonElement;
        const btnTxt = btn.querySelector("span")!;

        // 注册：两次密码一致性本地先查（省一趟网络）
        if (form.dataset.mode === "reg") {
          const pw2 = (form.querySelector('[name="password2"]') as HTMLInputElement).value;
          if (password !== pw2) return showErr(form, "两次输入的密码不一致");
        }

        btn.disabled = true;
        btnTxt.textContent = form.dataset.mode === "login" ? "登录中…" : "注册中…";
        try {
          const res = await fetch(`${API}/auth/${form.dataset.mode === "login" ? "login" : "register"}`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email, password }),
          });
          const d = await res.json().catch(() => ({ error: "internal" }));
          if (!res.ok || !d.ok) {
            showErr(form, ERR_TEXT[d.error] ?? "出错了，稍后再试");
            return;
          }
          localStorage.setItem(TOKEN_KEY, d.token);
          location.href = "/account/";
        } catch {
          showErr(form, "网络异常，稍后再试");
        } finally {
          btn.disabled = false;
          btnTxt.textContent = form.dataset.mode === "login" ? "登录" : "注册";
        }
      });
    });
  </script>
</Layout>

<style>
  /* body 纵向弹性（仅本页）：卡片在剩余视口内垂直居中，页脚沉底 */
  :global(body) {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  /* 视觉隐藏但可聚焦（radio 承载键盘操作，焦点环转投到对应 label） */
  .sr { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Layout 的 .btn 未含 font-family：按钮元素需显式继承，仅命中本页按钮 */
  .btn { font-family: inherit; }
  .btn-block { width: 100%; }
  .btn[disabled] { opacity: 0.6; pointer-events: none; }

  /* ============ 主体布局：居中单卡 ============ */
  .auth {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 52px 20px 60px;
    position: relative;
  }

  /* 卡片：主页 cell 同款材质（渐变白 + 细边 + 双层投影），叠一层淡蓝顶光 */
  .auth-card {
    position: relative;
    width: min(452px, 100%);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background: linear-gradient(180deg, var(--s2), var(--s1));
    box-shadow: 0 1px 2px rgba(20, 28, 45, 0.04), 0 14px 40px rgba(20, 28, 45, 0.08);
    padding: 28px 30px 26px;
    animation: rise 0.6s var(--ease) both;
  }
  .auth-card::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background: radial-gradient(340px 130px at 86% -12%, rgba(42, 120, 214, 0.08), transparent 62%);
  }

  /* ============ 登录 / 注册 分段 tab（radio 驱动，滑块随选中移动） ============ */
  .tabs {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    padding: 4px;
    margin-bottom: 22px;
    background: var(--s3);
    border: 1px solid var(--line);
    border-radius: 13px;
  }
  .tabs label {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 9px 0;
    font-size: 0.92rem;
    font-weight: 650;
    color: var(--ink-2);
    cursor: pointer;
    border-radius: 9px;
    transition: color 0.25s;
  }
  .tabs .slider {
    position: absolute;
    z-index: 0;
    top: 4px;
    left: 4px;
    bottom: 4px;
    width: calc(50% - 6px);
    background: #fff;
    border: 1px solid rgba(31, 102, 184, 0.3);
    border-radius: 9px;
    box-shadow: 0 2px 8px rgba(20, 28, 45, 0.1);
    transition: transform 0.32s var(--ease);
  }
  #m-login:checked ~ .auth-card .tabs label[for="m-login"],
  #m-reg:checked ~ .auth-card .tabs label[for="m-reg"] { color: var(--blue-2); }
  #m-reg:checked ~ .auth-card .tabs .slider { transform: translateX(calc(100% + 4px)); }
  #m-login:focus-visible ~ .auth-card .tabs label[for="m-login"],
  #m-reg:focus-visible ~ .auth-card .tabs label[for="m-reg"] { outline: 2px solid var(--blue-2); outline-offset: 2px; }

  /* ============ 标题区（随 tab 切换文案） ============ */
  .auth-ico {
    position: relative;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    margin-bottom: 14px;
    background: rgba(42, 120, 214, 0.08);
    border: 1px solid rgba(31, 102, 184, 0.26);
  }
  .auth-ico .ic { width: 24px; height: 24px; }
  .auth-head { position: relative; margin-bottom: 20px; }
  .auth-head .head { display: none; }
  #m-login:checked ~ .auth-card .head-login,
  #m-reg:checked ~ .auth-card .head-reg { display: block; animation: paneIn 0.3s var(--ease); }
  .auth-head h1 { font-size: 1.6rem; font-weight: 780; letter-spacing: -0.01em; line-height: 1.3; }
  .auth-head p { margin-top: 6px; font-size: 0.88rem; color: var(--ink-3); }

  /* ============ 表单面板切换 ============ */
  .pane { display: none; }
  #m-login:checked ~ .auth-card .pane-login,
  #m-reg:checked ~ .auth-card .pane-reg { display: block; animation: paneIn 0.34s var(--ease); }
  @keyframes paneIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }

  /* ============ 输入（白底 / 1px 边 / 蓝描边 focus，高 48px） ============ */
  .field { margin-bottom: 14px; position: relative; }
  .flabel { display: block; font-size: 0.84rem; font-weight: 650; color: var(--ink-2); margin-bottom: 7px; }
  .inp {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 48px;
    padding: 0 13px;
    background: #fff;
    border: 1px solid var(--line-strong);
    border-radius: 13px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .inp:hover { border-color: rgba(0, 0, 0, 0.28); }
  .inp:focus-within { border-color: var(--blue-2); box-shadow: 0 0 0 3.5px rgba(31, 102, 184, 0.13); }
  .inp .ic { width: 18px; height: 18px; color: var(--ink-3); transition: color 0.2s; }
  .inp:focus-within .ic { color: var(--blue-2); }
  .inp input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: none;
    outline: none;
    background: transparent;
    font: inherit;
    font-size: 0.93rem;
    color: var(--ink-1);
  }
  .inp input::placeholder { color: var(--ink-3); opacity: 1; }

  /* 提交失败提示条（脚本填文案） */
  .form-err {
    margin: 2px 0 14px;
    padding: 10px 13px;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--red);
    background: rgba(208, 59, 59, 0.06);
    border: 1px solid rgba(208, 59, 59, 0.28);
    border-radius: 12px;
    animation: paneIn 0.25s var(--ease);
  }

  /* ============ 注册说明小字 ============ */
  .trial {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    margin: 2px 0 16px;
    padding: 10px 13px;
    font-size: 0.78rem;
    line-height: 1.7;
    color: #17457e;
    background: rgba(42, 120, 214, 0.07);
    border: 1px solid rgba(31, 102, 184, 0.22);
    border-radius: 12px;
  }
  .trial .ic { width: 15px; height: 15px; margin-top: 3px; color: var(--blue-2); }
  .trial b { font-weight: 650; }

  /* ============ 条款勾选行（label 只包住勾选框，链接独立以免点链误触） ============ */
  .agree { display: flex; align-items: flex-start; gap: 10px; margin: 6px 0 20px; }
  .agree-cb { display: inline-flex; cursor: pointer; flex: none; }
  .agree input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .agree .box {
    width: 18px;
    height: 18px;
    margin-top: 2px;
    border-radius: 6px;
    display: grid;
    place-items: center;
    border: 1.5px solid var(--line-strong);
    background: #fff;
    transition: background 0.2s, border-color 0.2s;
  }
  .agree .box .ic {
    width: 12px;
    height: 12px;
    color: #fff;
    opacity: 0;
    transform: scale(0.5);
    transition: opacity 0.2s, transform 0.2s var(--ease);
  }
  .agree input:checked + .box { background: linear-gradient(135deg, var(--blue), var(--blue-deep)); border-color: var(--blue-2); }
  .agree input:checked + .box .ic { opacity: 1; transform: scale(1); }
  .agree input:focus-visible + .box { outline: 2px solid var(--blue-2); outline-offset: 2px; }
  .agree-txt { font-size: 0.8rem; color: var(--ink-2); line-height: 1.7; margin-top: 1px; }
  .agree-txt a {
    color: var(--blue-soft);
    text-decoration: underline;
    text-decoration-color: rgba(31, 102, 184, 0.4);
    text-underline-offset: 3px;
  }
  .agree-txt a:hover { color: var(--blue-2); }

  /* ============ 卡片下方小字 ============ */
  .under-note {
    margin-top: 22px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: var(--ink-3);
    text-align: center;
  }
  .under-note .ic { width: 14px; height: 14px; }

  /* ============ motion ============ */
  @keyframes rise {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }

  /* ============ responsive：375px 单列 ============ */
  @media (max-width: 639px) {
    .auth { padding: 32px 14px 44px; }
    .auth-card { padding: 22px 20px 20px; border-radius: 22px; }
    .inp input { font-size: 16px; } /* 防 iOS 聚焦自动放大 */
    .tabs label { font-size: 0.88rem; padding: 8px 0; }
    .agree-txt { font-size: 0.78rem; }
  }
</style>
