---
interface Props {
  /** full = 主页整屏强度；soft = 子页弱一档（整层降低不透明度） */
  strength?: "full" | "soft";
}
const { strength = "full" } = Astro.props;
---

<!-- 流动极光层：彩色流动光，位于内容之下、暖白底之上（CSS 与参数原样出自 bento-light 风格稿） -->
<div class:list={["aurora", { "aurora--soft": strength === "soft" }]} aria-hidden="true">
  <i class="a1"></i><i class="a2"></i><i class="a3"></i><i class="a4"></i><i class="a5"></i>
</div>

<style>
  .aurora {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 160vh;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 38%, rgba(0, 0, 0, 0.5) 66%, transparent 94%);
    mask-image: linear-gradient(180deg, #000 0%, #000 38%, rgba(0, 0, 0, 0.5) 66%, transparent 94%);
  }
  .aurora i {
    position: absolute;
    display: block;
    border-radius: 50%;
  }
  .aurora .a1 {
    width: 60vmax;
    height: 60vmax;
    left: -14vmax;
    top: -20vmax;
    background: radial-gradient(closest-side, rgba(42, 120, 214, 0.24), rgba(42, 120, 214, 0.1) 46%, transparent 72%);
    animation: au1 36s ease-in-out -4s infinite alternate;
  }
  .aurora .a2 {
    width: 54vmax;
    height: 54vmax;
    right: -16vmax;
    top: -14vmax;
    background: radial-gradient(closest-side, rgba(99, 87, 214, 0.22), rgba(99, 87, 214, 0.09) 46%, transparent 72%);
    animation: au2 30s ease-in-out -13s infinite alternate;
  }
  .aurora .a3 {
    width: 48vmax;
    height: 48vmax;
    left: 30vw;
    top: 2vh;
    background: radial-gradient(closest-side, rgba(25, 158, 112, 0.16), rgba(25, 158, 112, 0.06) 45%, transparent 72%);
    animation: au3 42s ease-in-out -22s infinite alternate;
  }
  .aurora .a4 {
    width: 42vmax;
    height: 42vmax;
    left: -10vmax;
    top: 48vh;
    background: radial-gradient(closest-side, rgba(178, 58, 104, 0.15), rgba(178, 58, 104, 0.06) 45%, transparent 72%);
    animation: au4 26s ease-in-out -9s infinite alternate;
  }
  .aurora .a5 {
    width: 50vmax;
    height: 50vmax;
    right: -8vmax;
    top: 58vh;
    background: radial-gradient(closest-side, rgba(31, 102, 184, 0.18), rgba(31, 102, 184, 0.07) 46%, transparent 72%);
    animation: au5 33s ease-in-out -17s infinite alternate;
  }
  @keyframes au1 {
    from { transform: translate(0, 0) scale(1) rotate(0deg); }
    to { transform: translate(9vmax, 5vmax) scale(1.12) rotate(8deg); }
  }
  @keyframes au2 {
    from { transform: translate(0, 0) scale(1.06) rotate(0deg); }
    to { transform: translate(-8vmax, 6vmax) scale(0.94) rotate(-7deg); }
  }
  @keyframes au3 {
    from { transform: translate(0, 0) scale(0.92); opacity: 0.85; }
    to { transform: translate(-6vmax, 7vmax) scale(1.1); opacity: 1; }
  }
  @keyframes au4 {
    from { transform: translate(0, 0) scale(1) rotate(0deg); }
    to { transform: translate(12vmax, -9vmax) scale(1.15) rotate(6deg); }
  }
  @keyframes au5 {
    from { transform: translate(0, 0) scale(1.05); opacity: 0.9; }
    to { transform: translate(-10vmax, -6vmax) scale(0.95); opacity: 1; }
  }
  .aurora--soft {
    opacity: 0.55;
  }
  @media (max-width: 639px) {
    .aurora { height: 135vh; }
    .aurora .a2 { right: -22vmax; }
    .aurora .a3 { left: 6vw; }
  }
</style>
