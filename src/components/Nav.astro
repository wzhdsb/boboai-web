---
interface Props {
  /** home = 主页形态（锚点导航 + 注册登录）；sub = 子页形态（logo 回首页，右侧按 prop 变化） */
  variant?: "home" | "sub";
  /** 右侧按钮文案；传空字符串则隐藏按钮 */
  ctaLabel?: string;
  ctaHref?: string;
  /** 已登录态：传入用户名后，右侧以「首字母头像 + 用户名」替代 CTA 按钮（点击进用户中心 /account/）；不传则维持原形态 */
  avatar?: string;
}
const { variant = "home", ctaLabel = "注册登录", ctaHref = "/login/", avatar } = Astro.props;
const avatarInitial = avatar?.trim().charAt(0).toUpperCase();
---

<nav class="topnav" aria-label="主导航">
  <div class="wrap nav-in">
    <a class="brand" href={variant === "home" ? "#top" : "/"} aria-label="BOBO 首页">
      <svg class="logo" aria-hidden="true"><use href="#i-logo" /></svg>
      BOBO<small>AI 助理</small>
    </a>
    {variant === "home" && (
      <div class="nav-links">
        <a href="#features">功能</a>
        <a href="#plans">订阅</a>
        <a href="#download">下载</a>
        <a href="#faq">FAQ</a>
      </div>
    )}
    {avatar ? (
      /* 占位：已登录态——圆形头像占位（首字母）+ 用户名占位，正式版接真实头像与昵称 */
      <a class="nav-user" href="/account/">
        <span class="avatar" aria-hidden="true">{avatarInitial}</span>
        <span class="nav-uname">{avatar}</span>
      </a>
    ) : (
      ctaLabel && (
        <a class="btn btn-primary btn-sm nav-cta" href={ctaHref}>
          <svg class="ic" aria-hidden="true"><use href="#i-user" /></svg>{ctaLabel}
        </a>
      )
    )}
  </div>
</nav>

<style>
  .topnav {
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgba(247, 246, 243, 0.82);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--line);
    animation: dropIn 0.5s var(--ease) both;
  }
  @keyframes dropIn {
    from { transform: translateY(-100%); opacity: 0; }
    to { transform: none; opacity: 1; }
  }
  .nav-in { display: flex; align-items: center; gap: 26px; height: 62px; }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--ink-1);
  }
  .brand .logo { width: 26px; height: 26px; }
  .brand small {
    font-weight: 500;
    color: var(--ink-3);
    font-size: 0.78rem;
    margin-left: 2px;
    letter-spacing: 0.04em;
  }
  .nav-links { display: flex; gap: 4px; margin-left: 8px; }
  .nav-links a {
    position: relative;
    padding: 8px 13px;
    font-size: 0.9rem;
    color: var(--ink-2);
    border-radius: 10px;
    transition: color 0.2s, background 0.2s;
  }
  .nav-links a::after {
    content: "";
    position: absolute;
    left: 13px;
    right: 13px;
    bottom: 5px;
    height: 1.5px;
    background: var(--blue-2);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }
  .nav-links a:hover { color: var(--ink-1); background: rgba(0, 0, 0, 0.045); }
  .nav-links a:hover::after { transform: scaleX(1); }
  .nav-cta { margin-left: auto; }
  /* 已登录态（avatar prop 传入时渲染，与 nav-cta 互斥） */
  .nav-user {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 5px 12px 5px 6px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.85);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .nav-user:hover { border-color: rgba(31, 102, 184, 0.4); box-shadow: 0 4px 12px rgba(20, 28, 45, 0.07); }
  .avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    flex: none;
    background: linear-gradient(135deg, var(--blue-2), var(--violet));
    color: #fff;
    font-weight: 750;
    font-size: 0.92rem;
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.65), 0 2px 6px rgba(20, 28, 45, 0.14);
  }
  .nav-uname { font-size: 0.9rem; font-weight: 650; color: var(--ink-1); }
  @media (max-width: 899px) {
    .nav-links { display: none; }
  }
</style>
